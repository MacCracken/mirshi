# src/intercept.cyr — the supervisor trap loop (the impure core). Two modes:
#
#   --selftest-trace (selftest==1): the M0 mode — trap EVERY syscall via
#     ptrace(PTRACE_SYSEMU), log the agnos number+name+args, execute/translate
#     NOTHING (tear down on agnos exit#0). Proven by scripts/it/m0_trap.sh.
#   default        (selftest==0): the M1 mode — trap, then TRANSLATE + EXECUTE
#     each agnos syscall so the binary actually runs as a native Linux process.
#
# Why PTRACE_SYSEMU and not PTRACE_SYSCALL for the TRAP: agnos and Linux share
# the identical register ABI and `syscall` instruction emit — only the NUMBERS
# differ. Under a bare PTRACE_SYSCALL the host kernel would EXECUTE the child's
# foreign agnos number against the Linux table (agnos exit#0 -> Linux read#0,
# the child blocks reading into garbage; agnos sock_accept#57 -> Linux fork#57,
# a fork bomb). PTRACE_SYSEMU stops at syscall ENTRY and SUPPRESSES kernel
# execution, so we see every call before anything runs. See docs/adr/0001.
#
# M1 translation (docs/adr/0002): run mode resumes with PTRACE_SYSCALL, which
# stops the child at BOTH syscall entry and exit (an alternating phase the loop
# tracks via `at_entry`). At the ENTER stop the dispatcher (src/dispatch.cyr)
# classifies the call: EXECUTE renumbers orig_rax to the Linux peer (+ synthesizes
# args) so the kernel runs it IN the child's own address space (pointers + a new
# mmap land natively); EMULATE/ENOSYS SKIP the call (orig_rax = -1) so the foreign
# agnos number is never run as a Linux syscall, computing the return in the
# supervisor. At the matching EXIT stop the loop maps the raw Linux return to the
# agnos convention (EXECUTE) or injects the supervisor-computed value into rax
# (EMULATE/ENOSYS). agnos exit#0 is renumbered to a real exit_group, so the child
# terminates and waitpid carries its status out. No rip rewrite — the kernel
# dispatches on orig_rax at the enter stop (the rip-rewind path is ADR 0002's
# rejected alternative).
#
# x86_64 Linux ONLY: PTRACE_SYSEMU/SYSCALL and the user_regs_struct offsets
# (decode.cyr) are x86_64-specific. The fixtures + supervisor are x86_64 targets.

include "src/decode.cyr"

# ----------------------------------------------------------------------------
# ptrace ABI constants the Linux stdlib peer does NOT define (it has no
# SYS_PTRACE / PTRACE_* at all). Kept in an enum to stay under the gvar budget.
# ----------------------------------------------------------------------------
enum MirshiPtrace {
    SYS_PTRACE = 101;
    SYS_CLOSE_RANGE = 436;
    MFD_CLOEXEC = 1;                  # 1.12.3: memfd_create flag — the spawn#3 image fd closes at execveat
    F_DUPFD_X = 0;                    # 1.13.1 fcntl: duplicate onto the lowest free fd >= arg
    F_DUPFD_CLOEXEC_X = 1030;         # ...with FD_CLOEXEC
    INH_FDS = 32;                     # 1.13.1: the kernel's per-process fd table — what a child inherits
    SPAWN_HIGH_FD = 101;              # 1.13.1: a grandchild's own fds (status pipe, memfd) sit above ROOTFD (100)
    SPAWN_ST_SETUP = 1;               # 1.13.1 exec-status word: the pre-exec gauntlet failed (else: -errno)
    SPAWN_STATUS_MS = 5000;           # 1.13.1: the longest the supervisor waits to learn whether an exec worked
    PTRACE_TRACEME = 0;
    PTRACE_CONT = 7;
    PTRACE_SYSCALL = 24;              # resume + EXECUTE one (rewritten) call, stop at exit
    PTRACE_GETREGS = 12;
    PTRACE_SETREGS = 13;              # M1: write the rewritten args back at the ENTER stop
    PTRACE_PEEKUSER = 3;              # 0.8.0: read ONE user-area word (exit stop needs only rax)
    PTRACE_POKEUSER = 6;              # 0.8.0: write ONE user-area word (exit stop writes only rax)
    PTRACE_SYSEMU = 31;
    PTRACE_GETSIGINFO = 0x4202;       # 0.6.0: probe a non-syscall stop — fails -EINVAL at a group-stop
    PTRACE_SETOPTIONS = 0x4200;
    PTRACE_O_TRACESYSGOOD = 0x1;      # syscall-stops report SIGTRAP|0x80
    PTRACE_O_EXITKILL = 0x100000;     # SIGKILL the child if the tracer dies
    SIG_KILL = 9;
    SIGTSTP = 20;                     # at a group-stop the supervisor suppresses them (resume with
    SIGTTIN = 21;                     # no signal) instead of re-injecting a stop it never originated
    SIGTTOU = 22;
    SIGINFO_SIZE = 128;              # siginfo_t size on x86_64 (PTRACE_GETSIGINFO output buffer)
    SYSCALL_STOP_SIG = 0x85;          # SIGTRAP(5) | 0x80 — the TRACESYSGOOD marker
    EXECVE_FAILED = 127;
    BOUND_FAILED = 126;               # seccomp bound failed to install — child aborted, not run unbounded
    WAIT_FAILED = 125;                # mirshi's own exit code when a wait fails irrecoverably
    __WALL = 0x40000000;              # wait4: reap children of ANY signal-delivery flavor (v1.5.0
    # multi-tracee demux; robust for supervisor-forked grandchildren)
    PAUSE_YIELD_NS = 1000000;         # v1.6.0 pause#14 bounded-yield quantum (1 ms — the "one hlt"
    # idle; short-circuited to 0 when a deliverable signal is pending)
}

# wait-status decoders the stdlib lacks. lib/syscalls_linux_common.cyr provides
# WIFEXITED / WEXITSTATUS / WIFSIGNALED / WTERMSIG, but NOT the stopped pair.
# WIFSTOPPED: low byte == 0x7f. WSTOPSIG: next byte.
fn WIFSTOPPED(status): i64 {
    if ((status & 0xff) == 0x7f) { return 1; }
    return 0;
}
fn WSTOPSIG(status): i64 {
    return (status >> 8) & 0xff;
}

# Thin ptrace(2) wrapper: ptrace(request, pid, addr, data).
fn pt(req, pid, addr, data): i64 {
    return syscall(SYS_PTRACE, req, pid, addr, data);
}

# v1.5.0 spawn#3 stages the child ELF in an anonymous memfd (execveat'd in the forked grandchild,
# AT_EMPTY_PATH) — SUPERVISOR-side (pre-fork), NOT in the child seccomp bound. `sys_memfd_create`
# itself is the stdlib's (lib/syscalls_linux_common.cyr, cyrius ≥ 6.6.5); mirshi's own copy was
# dropped at 1.11.4 when the stdlib grew the identical wrapper.

# Write a NUL-terminated cstr to a fd without hand-counting its length.
fn _emit(fd, s): i64 {
    file_write(fd, s, strlen(s));
    return 0;
}
# Write a decimal int to a fd.
fn _emit_int(fd, n): i64 {
    var tmp[24];
    var len = fmt_int_buf(n, &tmp);
    file_write(fd, &tmp, len);
    return 0;
}

# wait4(pid) that zeroes the status word first and retries on -EINTR. Returns
# the wait4 result (pid >= 0 on success, < 0 = -errno on a real failure). The
# status pre-zero matters: WIFEXITED(0) is true, so a caller that ignored a
# failed wait would silently launder it into "child exited, code 0" — every
# caller here checks this return < 0 instead.
fn _wait(pid, status): i64 {
    var r = 0;
    while (1 == 1) {
        store64(status, 0);
        r = sys_waitpid(pid, status, 0);   # wait4(pid, status, 0, NULL)
        if (r >= 0) { return r; }
        if (r == 0 - 4) { continue; }      # -EINTR: interrupted, retry
        return r;                          # other error (e.g. -ECHILD)
    }
    return r;
}

# wait4(-1, &status, __WALL, NULL) — reap the next event from ANY traced child (the v1.5.0
# multi-tracee loop's demux point), zeroing status first + retrying on -EINTR like _wait.
# Returns the woken host pid (> 0), or < 0 = -errno on a real failure.
fn _wait_any(status): i64 {
    var r = 0;
    while (1 == 1) {
        store64(status, 0);
        r = sys_waitpid(0 - 1, status, __WALL);   # wait4(-1, status, __WALL, NULL)
        if (r >= 0) { return r; }
        if (r == 0 - 4) { continue; }             # -EINTR: interrupted, retry
        return r;
    }
    return r;
}

# The translation layer: pure agnos->Linux mapping (src/translate.cyr, also
# unit-tested) then the impure register-rewriting dispatcher (src/dispatch.cyr).
# Included HERE so they see decode.cyr's REG_*, the MirshiPtrace enum, pt(), and
# _emit/_emit_int defined above, and so _trace_loop below sees translate_dispatch.
include "src/translate.cyr"
include "src/scratch.cyr"
include "src/children.cyr"
include "src/emu_core.cyr"
include "src/band_fs.cyr"
include "src/band_net.cyr"
include "src/band_signals.cyr"
include "src/band_iomux.cyr"
include "src/band_info.cyr"
include "src/band_kbscan.cyr"
include "src/band_fdkind.cyr"
include "src/band_console.cyr"
include "src/band_resync.cyr"
include "src/band_cwd.cyr"
include "src/dispatch.cyr"
include "src/seccomp.cyr"
include "src/limits.cyr"

# v1.5.0 spawn#3 config: intercept_run stashes the run-mode bound + rootpath here so a supervisor-
# forked grandchild (_child_exec_memfd) can re-run the same gauntlet — it forks fresh from the mirshi
# binary and inherits neither ROOTFD nor the seccomp filter, so both must be re-established.
var _spawn_bound = 0;
var _spawn_rootpath = 0;

# 1.13.1: a spawned grandchild's end of its exec-status pipe (O_CLOEXEC: an exec that works closes it, so
# the supervisor reads EOF; one that fails writes an 8-byte status word first). -1 = none (the root child).
var _child_status_fd = 0 - 1;

# Leave the child before its image runs: report `st` on the status pipe (when there is one), exit `code`.
fn _child_fail(st, code): i64 {
    if (_child_status_fd >= 0) {
        var w[8];
        store64(&w, st);
        syscall(SYS_WRITE, _child_status_fd, &w, 8);
    }
    syscall(SYS_EXIT, code);
    return code;
}

# The shared pre-exec gauntlet, run by BOTH the root child (_child_exec) and a spawn#3 grandchild
# (_child_exec_memfd). Runs the ABSOLUTE MINIMUM between fork and exec — mark self as tracee, then
# the 0.6.0 rlimits, the 0.7.1 rootfd anchor, and the M3 seccomp bound. No alloc/print: a stray
# syscall here is a spurious pre-image trap. Each step FAIL-CLOSED (SYS_EXIT — never run with
# confinement/bound silently off). Returns 0 on full success; never returns on a setup failure.
fn _child_setup(bound, rootpath, lo, k1, k2): i64 {
    pt(PTRACE_TRACEME, 0, 0, 0);
    # 0.6.0 host-resource bounds: kernel-enforced rlimits (address space + fds) so a runaway/hostile
    # child can't exhaust the host. ALWAYS on and FIRST — before any seccomp filter, so prlimit64
    # needs no allowlist entry and the child can't raise them.
    apply_child_rlimits();
    # 1.12.3 fd hygiene: every fd >= `lo` the child would inherit (whatever mirshi's own parent left open,
    # and, for a grandchild, the supervisor's host sockets and pidfds) is closed, except k1 / k2 (a
    # grandchild's status pipe and spawn#3 memfd; -1 = none). The root child keeps 0-2 (lo = 3); since
    # 1.13.1 a spawned grandchild keeps 0-31, the table it inherited from its creator (lo = 32,
    # _child_shape_fds). BEFORE the rootfd is pinned below, so ROOTFD is the only descriptor the confined
    # child holds that neither it nor its creator opened (ADR 0009's premise).
    _child_close_inherited(lo, k1, k2);
    # 0.7.1 rootfs confinement: open the configured root as the child's anchor fd, pinned at the fixed
    # ROOTFD the dispatcher anchors every confined open#7 at. BEFORE the seccomp filter (dup3 is not
    # allowlisted), WITHOUT O_CLOEXEC (must survive exec). O_PATH keeps it inert as a data handle yet
    # valid as an openat2 anchor. FAIL-CLOSED. See docs/adr/0009.
    if (rootpath != 0) {
        var rfd = syscall(HOST_OPEN, rootpath, O_PATH | O_DIRECTORY, 0);
        if (rfd < 0) {
            _emit(2, "mirshi: --root open failed — refusing to run child unconfined\n");
            return _child_fail(SPAWN_ST_SETUP, BOUND_FAILED);
        }
        if (rfd != ROOTFD) {
            # dup3 returns the new fd on success — fail-closed if it does NOT land at ROOTFD, else the
            # child runs with the anchor fd wrong (openat2 would resolve against the wrong fd).
            if (syscall(HOST_DUP3, rfd, ROOTFD, 0) != ROOTFD) {
                _emit(2, "mirshi: --root dup3 failed — refusing to run child unconfined\n");
                return _child_fail(SPAWN_ST_SETUP, BOUND_FAILED);
            }
            syscall(HOST_CLOSE, rfd);
        }
    }
    # M3 bounding seccomp: restrict the child to the agnos surface before exec (the filter persists
    # across execve/execveat). FAIL-CLOSED (0.7.0 audit b1) — a sandbox that silently runs unbounded
    # is worse than not running. See docs/adr/0004.
    if (bound == 1) {
        if (apply_child_bound() != 0) {
            _emit(2, "mirshi: seccomp bound failed to install — refusing to run child unbounded\n");
            return _child_fail(SPAWN_ST_SETUP, BOUND_FAILED);
        }
    }
    return 0;
}

# Close every fd >= `lo` except k1 and k2 (-1 = none): close_range(2) (Linux 5.9+), else a loop. Runs in
# the child between fork and exec, before the seccomp filter (close_range is not on the allowlist).
fn _child_close_inherited(lo, k1, k2): i64 {
    var a = k1;
    var b = k2;
    if (a > b) { a = k2; b = k1; }                      # a <= b
    var from = lo;
    var ok = 1;
    if (a >= from) {
        if (a > from) { if (syscall(SYS_CLOSE_RANGE, from, a - 1, 0) != 0) { ok = 0; } }
        from = a + 1;
    }
    if (b >= from) {
        if (b > from) { if (syscall(SYS_CLOSE_RANGE, from, b - 1, 0) != 0) { ok = 0; } }
        from = b + 1;
    }
    if (ok == 1) { if (syscall(SYS_CLOSE_RANGE, from, 0xFFFFFFFF, 0) == 0) { return 0; } }
    var fd = lo;                                        # no close_range: close the fd table's span
    while (fd < 4096) {
        if (fd != k1) { if (fd != k2) { syscall(HOST_CLOSE, fd); } }
        fd = fd + 1;
    }
    return 0;
}

# The root child, and a #37 / #43 grandchild: run the gauntlet, then load the agnos ELF from `path` via
# execve (returns only on failure, after reporting it on the status pipe).
fn _child_exec(path, bound, rootpath, child_argv, envp, lo, keep, in_root): i64 {
    _child_setup(bound, rootpath, lo, keep, 0 - 1);    # never returns on a setup failure
    # child_argv (v1.10.0): the NULL-terminated [path, args…] vector built by main() on the
    # supervisor heap pre-fork (inherited across the fork). Before this the child ran with a
    # hard-coded [path, NULL] and lost every argument past the ELF. envp (1.13.1): the init env the
    # kernel's loader stages — HOME=/ and PWD=<cwd>, or a #37 / #43 caller's own blob.
    if (in_root == 1) {
        # 1.12.3: a path an agnos program asked to run (execwait#37 / spawn_path#43) under --root is
        # resolved INSIDE the root — openat2(ROOTFD, path, RESOLVE_IN_ROOT | RESOLVE_NO_MAGICLINKS), the
        # resolution open#7 uses — and executed from that fd. Until 1.12.3 it was execve'd as a host path.
        var how[24];
        store64(&how + 0, O_PATH | O_CLOEXEC);
        store64(&how + 8, 0);
        store64(&how + 16, OPEN_RESOLVE);
        var xfd = syscall(SYS_OPENAT2, ROOTFD, path, &how, OPEN_HOW_SIZE);
        if (xfd < 0) { return _child_fail(xfd, EXECVE_FAILED); }
        var empty[8];
        store8(&empty, 0);
        var xr = sys_execveat(xfd, &empty, child_argv, envp, AT_EMPTY_PATH);
        return _child_fail(xr, EXECVE_FAILED);
    }
    var er = sys_execve(path, child_argv, envp);
    return _child_fail(er, EXECVE_FAILED);
}

# A spawn#3 grandchild (v1.5.0): run the SAME gauntlet, then load the in-memory ELF from `memfd` via
# execveat(memfd, "", [NULL], [NULL], AT_EMPTY_PATH) — agnos spawn passes no argv/envp. The memfd
# (opened by the supervisor pre-fork) is inherited across the fork. The grandchild forks fresh from
# the mirshi binary (NOT cloned from the agnos parent), so _child_setup re-establishes ROOTFD + the
# bound (fed _spawn_rootpath / _spawn_bound by the caller). execveat returns only on failure.
fn _child_exec_memfd(memfd, bound, rootpath): i64 {
    _child_setup(bound, rootpath, INH_FDS, memfd, _child_status_fd);   # keeps the inherited 0-31 + memfd
    var empty[8];
    store8(&empty, 0);                      # "" — AT_EMPTY_PATH operates on the fd itself
    var argv[8];
    store64(&argv, 0);                      # argv = [NULL]
    var envp[8];
    store64(&envp, 0);                      # envp = [NULL]
    var r = sys_execveat(memfd, &empty, &argv, &envp, AT_EMPTY_PATH);
    return _child_fail(r, EXECVE_FAILED);
}

# ============================================================================
# 1.13.1 — what a spawned child is born with (the kernel's proc_create_user + spawn_load_child):
#   * its creator's fd table: fds 0..31 as the creator holds them (vfs_fd_inherit). The supervisor
#     duplicates each of the caller's fds with pidfd_getfd BEFORE the fork, and the grandchild puts them at
#     the same numbers; a closed fd stays closed. Then, for #37 / #43, the caller's armed exec_redirect#62
#     pairs apply in arm order (child[src] = child[dst]), and #43's SPAWN_F_CLEANFD closes 3..31 except the
#     redirect sources. mirshi's emulated signalfd / timerfd / epoll ids are per-process tables, not fds,
#     and are not inherited.
#   * its creator's working directory, or (#37 / #43) a valid PWD= from the env blob it was given;
#   * (#37 / #43) the init env: the caller's blob (a3 / a4) or the kernel default HOME=/ + PWD=<the
#     creator's cwd>. spawn#3's in-memory loader stages no env at all.
# And the supervisor learns whether the exec worked from a status pipe, so a failure is the caller's
# answer (-4 / -5 from #43, -1 from #37 and #3) instead of a pid that dies at once.
# ============================================================================
var _inh = 0;                   # INH_FDS x i64: the caller's fds duplicated into the supervisor; -1 = closed
var _sp_envblob = 0;            # the caller's env blob (ENV_BLOB_MAX + 8)
var _sp_envp = 0;               # the child's envp vector (ENV_ENTRIES_MAX + 1 pointers)
var _sp_envdef = 0;             # the default env strings: "HOME=/\0PWD=<cwd>\0"
var _sp_cwd = 0;                # the child's starting cwd (CWD_SLOT + 8); _sp_cwd_n bytes, 0 = "/"
var _sp_cwd_n = 0;
var _sp_xpath = 0;              # the resolved program path (PATH_MAX + 8)

fn _sp_bufs(): i64 {
    if (_inh == 0) {
        _inh = alloc(INH_FDS * 8);
        _sp_envblob = alloc(ENV_BLOB_MAX + 8);
        _sp_envp = alloc((ENV_ENTRIES_MAX + 1) * 8);
        _sp_envdef = alloc(CWD_SLOT + 16);
        _sp_cwd = alloc(CWD_SLOT + 8);
        _sp_xpath = alloc(PATH_MAX + 8);
    }
    return 0;
}

# Duplicate the caller's (host pid `hpid`) fds 0..31 into the supervisor, into _inh. A fd that is closed,
# or that pidfd_getfd cannot take, is -1 (the child gets it closed).
fn _inh_collect(hpid): i64 {
    _sp_bufs();
    var i = 0;
    while (i < INH_FDS) { store64(_inh + i * 8, 0 - 1); i = i + 1; }
    var pfd = syscall(SYS_PIDFD_OPEN, hpid, 0);
    if (pfd < 0) {
        # no pidfd (a kernel before 5.3, or a sandbox that refuses it): the child gets mirshi's own 0-2,
        # the 1.12.3 behaviour, rather than no stdio at all
        i = 0;
        while (i < 3) { store64(_inh + i * 8, syscall(SYS_FCNTL, i, F_DUPFD_CLOEXEC_X, 3)); i = i + 1; }
        return 0;
    }
    i = 0;
    while (i < INH_FDS) {
        var f = syscall(SYS_PIDFD_GETFD, pfd, i, 0);
        if (f >= 0) { store64(_inh + i * 8, f); }
        i = i + 1;
    }
    syscall(HOST_CLOSE, pfd);
    return 0;
}

# The supervisor's copies, closed once the grandchild has its own.
fn _inh_release(): i64 {
    var i = 0;
    while (i < INH_FDS) {
        var f = load64(_inh + i * 8);
        if (f >= 0) { syscall(HOST_CLOSE, f); }
        store64(_inh + i * 8, 0 - 1);
        i = i + 1;
    }
    return 0;
}

# In the grandchild, before the gauntlet: move `fd` (a status pipe end / the memfd) above ROOTFD, out of the
# way of the inherited table. The new fd, or `fd` itself when it is already there or cannot move.
fn _child_fd_high(fd): i64 {
    if (fd < 0) { return fd; }
    if (fd >= SPAWN_HIGH_FD) { return fd; }
    var n = syscall(SYS_FCNTL, fd, F_DUPFD_CLOEXEC_X, SPAWN_HIGH_FD);
    if (n < 0) { return fd; }
    return n;
}

# In the grandchild: put the inherited table in place (fds 0..31), then — `rec` = the caller's record, its
# fork-time copy — apply the caller's redirect pairs when `redir` is 1, and the CLEANFD scrub when `clean`
# is 1. Every inherited duplicate below 32 first moves to >= 32, so placing fd i never overwrites a source.
fn _child_shape_fds(rec, redir, clean): i64 {
    var i = 0;
    while (i < INH_FDS) {
        var f = load64(_inh + i * 8);
        if (f >= 0) { if (f < INH_FDS) { store64(_inh + i * 8, syscall(SYS_FCNTL, f, F_DUPFD_X, INH_FDS)); } }
        i = i + 1;
    }
    i = 0;
    while (i < INH_FDS) {
        var g = load64(_inh + i * 8);
        var placed = 0;
        if (g >= 0) { if (syscall(HOST_DUP3, g, i, 0) == i) { placed = 1; } }
        if (placed == 0) { syscall(HOST_CLOSE, i); }
        i = i + 1;
    }
    if (redir == 1) {
        var n = load64(rec + C_REDIR_N);
        var k = 0;
        while (k < n) {
            var src = _child_redir_src(rec, k);
            var dst = _child_redir_dst(rec, k);
            if (src != dst) {
                if (syscall(HOST_DUP3, dst, src, 0) != src) { syscall(HOST_CLOSE, src); }   # dst closed: src is too
            }
            k = k + 1;
        }
    }
    if (clean == 1) {
        var c = 3;
        while (c < INH_FDS) {
            if (_child_redir_is_src(rec, c) == 0) { syscall(HOST_CLOSE, c); }
            c = c + 1;
        }
    }
    return 0;
}

# A status pipe for one spawn: rfd at fds+0, wfd at fds+4 (both O_CLOEXEC). 0, or -1 (then no status).
fn _sp_pipe(fds): i64 {
    if (syscall(SYS_PIPE2, fds, O_CLOEXEC) != 0) { return 0 - 1; }
    return 0;
}

# After the fork: wait (at most SPAWN_STATUS_MS) for the grandchild's exec to work — EOF, the pipe closed by
# the exec — or fail, which writes its status word first. Returns 0 (it ran, or no answer in time), or the
# word: SPAWN_ST_SETUP, or the failed call's -errno. Closes rfd.
fn _sp_status(rfd): i64 {
    if (rfd < 0) { return 0; }
    var pf[8];
    store32(&pf, rfd);
    store16(&pf + 4, POLLIN);
    store16(&pf + 6, 0);
    var ts[16];
    store64(&ts, SPAWN_STATUS_MS / 1000);
    store64(&ts + 8, 0);
    var st = 0;
    if (syscall(SYS_PPOLL, &pf, 1, &ts, 0, 0) > 0) {
        var w[8];
        store64(&w, 0);
        if (syscall(HOST_READ, rfd, &w, 8) == 8) { st = load64(&w); }
    }
    syscall(HOST_CLOSE, rfd);
    return st;
}

# The child's envp for a #37 / #43 call (a3 = blob, a4 = its length; `fl` = a2's flags, `argv_bytes` =
# the argv strings' size): the caller's blob when a3 != 0 and it is 1..1024 readable bytes that pass
# env_blob_ok; else, refused (0) when any flag is set and a3 != 0, the kernel's -6; else the default
# HOME=/ + PWD=<the caller's cwd> (PWD omitted when it would not fit the init stack). Also sets the child's
# starting cwd (_sp_cwd / _sp_cwd_n): the blob's first PWD= when it is absolute, cleans to <= CWD_MAX and
# names an existing directory, else the caller's.
fn _sp_env(pid, regs, rec, fl, argv_bytes): i64 {
    _sp_bufs();
    var a3 = decode_arg(regs, 2);
    var a4 = decode_arg(regs, 3);
    var ok = 0;
    if (a3 != 0) {
        if (a4 >= 1) {
            if (a4 <= ENV_BLOB_MAX) {
                if (pvm_read(pid, a3, _sp_envblob, a4) == a4) { ok = env_blob_ok(_sp_envblob, a4); }
            }
        }
    }
    if (ok == 0) { if (fl != 0) { if (a3 != 0) { return 0; } } }
    # the starting cwd: a valid PWD= from the blob, else the caller's (the kernel's spawn_seed_cwd)
    var seeded = 0;
    var nv = 0;
    if (ok == 1) {
        var pw[16];
        if (env_first_pwd(_sp_envblob, a4, &pw) == 1) {
            var vo = load64(&pw);
            var vl = load64(&pw + 8);
            if (vl >= 1) {
                if (vl <= CWD_MAX) {
                    if (load8(_sp_envblob + vo) == 47) {
                        var cn = path_clean_join(0, 0, _sp_envblob + vo, vl, _sp_cwd);
                        if (cn >= 1) {
                            if (_cwd_is_dir(_sp_cwd) == 1) {
                                _sp_cwd_n = cn;
                                if (cn == 1) { _sp_cwd_n = 0; }
                                seeded = 1;
                            }
                        }
                    }
                }
            }
        }
    }
    if (seeded == 0) {
        _sp_cwd_n = load64(rec + C_CWD_LEN);
        if (_sp_cwd_n > 0) { memcpy(_sp_cwd, _child_cwd_ptr(rec), _sp_cwd_n + 1); }
    }
    if (ok == 1) {
        var i = 0;
        while (i < a4) {                                 # one pointer per non-empty entry
            var es = i;
            while (i < a4) { if (load8(_sp_envblob + i) == 0) { break; } i = i + 1; }
            if (i > es) {
                if (nv < ENV_ENTRIES_MAX) { store64(_sp_envp + nv * 8, _sp_envblob + es); nv = nv + 1; }
            }
            i = i + 1;
        }
        store64(_sp_envp + nv * 8, 0);
        return _sp_envp;
    }
    _sp_env_default(rec, argv_bytes);
    return _sp_envp;
}

# The kernel loader's default env into _sp_envp: "HOME=/" and "PWD=<rec's cwd>" — the PWD omitted when the
# init stack's string region could not hold it after `argv_bytes` of argv (-1 = never omit: the root child).
fn _sp_env_default(rec, argv_bytes): i64 {
    _sp_bufs();
    var d = _sp_envdef;
    memcpy(d, "HOME=/", 7);
    store64(_sp_envp, d);
    var nv = 1;
    var cn = load64(rec + C_CWD_LEN);
    var shown = cn;
    if (shown == 0) { shown = 1; }
    var fits = 1;
    if (argv_bytes >= 0) { fits = env_pwd_fits(argv_bytes, shown); }
    if (fits == 1) {
        var p = d + 7;
        memcpy(p, "PWD=", 4);
        if (cn == 0) { store8(p + 4, 47); } else { memcpy(p + 4, _child_cwd_ptr(rec), cn); }
        store8(p + 4 + shown, 0);
        store64(_sp_envp + 8, p);
        nv = 2;
    }
    store64(_sp_envp + nv * 8, 0);
    return 0;
}

# Lazy-alloc-once supervisor buffer for a staged spawn#3 child ELF (SPAWN_ELF_MAX bytes). One alloc,
# reused across spawns — the bump allocator never frees, so a per-spawn alloc would let a child that
# loops spawn grow the supervisor heap without bound (ADR 0008 discipline, like the M2 buffers).
var _spawn_elf = 0;
fn _spawn_elf_buffer(): i64 {
    if (_spawn_elf == 0) { _spawn_elf = alloc(SPAWN_ELF_MAX); }
    return _spawn_elf;
}

# Read `size` bytes of the child's in-memory ELF (at child address `addr`) into supervisor buffer
# `buf`, LOOPING to absorb short counts — a single process_vm_readv can stop at a page / mapping
# boundary, so re-read from where it left off until all `size` bytes land. Rejects size <= 0 / size >
# SPAWN_ELF_MAX up front (_spawn_size_ok). Returns the bytes read (== size on success), or -1 on a
# bad size or a read that makes no forward progress (error / short at a bad address).
fn _spawn_read_elf(pid, addr, size, buf): i64 {
    if (_spawn_size_ok(size) != 1) { return 0 - 1; }
    var got = 0;
    while (got < size) {
        var n = pvm_read(pid, addr + got, buf + got, size - got);
        if (n <= 0) { return 0 - 1; }     # read error or no forward progress -> fail closed
        got = got + n;
    }
    return got;
}

# spawn#3(elf_addr, elf_size) -> agnos pid / -1. A SUPERVISOR-CONTROL op — NOT a per-syscall
# translation, so handled at the loop level (here, after the includes) rather than in
# translate_dispatch, because it forks + runs _child_exec_memfd (which depend on limits.cyr/
# seccomp.cyr, included AFTER dispatch.cyr). Reads the caller's in-memory ELF, stages it into a
# memfd, forks a new TRACED grandchild that execveat's it, registers the grandchild (needs_attach —
# the demux loop sets its ptrace options on its first stop), and injects the coined agnos pid as
# spawn's return. Fail-closed to agnos -1 on any error. `rec` is the CALLER's (parent's) record.
fn _do_spawn(pid, regs, rec): i64 {
    # Storm bound: refuse BEFORE forking if the table is full (so we never fork an untrackable child).
    if (_child_count() >= MAX_CHILDREN) { return _net_emu(pid, regs, 0 - 1); }
    var elf_addr = decode_arg(regs, 0);
    var elf_size = decode_arg(regs, 1);
    var buf = _spawn_elf_buffer();
    if (_spawn_read_elf(pid, elf_addr, elf_size, buf) < 0) { return _net_emu(pid, regs, 0 - 1); }
    var memfd = sys_memfd_create("mirshi-spawn", MFD_CLOEXEC);   # 1.12.3: the image never sees its own fd
    if (memfd < 0) { return _net_emu(pid, regs, 0 - 1); }
    # Stage the ELF image into the memfd (loop on short writes).
    var written = 0;
    while (written < elf_size) {
        var w = file_write(memfd, buf + written, elf_size - written);
        if (w <= 0) { syscall(HOST_CLOSE, memfd); return _net_emu(pid, regs, 0 - 1); }
        written = written + w;
    }
    _inh_collect(pid);                              # 1.13.1: the caller's fds 0..31, for the child
    var sp[8];
    var sfd_r = 0 - 1;
    var sfd_w = 0 - 1;
    if (_sp_pipe(&sp) == 0) { sfd_r = load32(&sp) & 0xFFFFFFFF; sfd_w = load32(&sp + 4) & 0xFFFFFFFF; }
    var cpid = sys_fork();
    if (cpid < 0) {
        syscall(HOST_CLOSE, memfd);
        _inh_release();
        if (sfd_r >= 0) { syscall(HOST_CLOSE, sfd_r); syscall(HOST_CLOSE, sfd_w); }
        return _net_emu(pid, regs, 0 - 1);
    }
    if (cpid == 0) {
        # Grandchild: its own fds above ROOTFD, the creator's table at 0..31 (spawn#3 consumes no
        # redirects), then the gauntlet + execveat the memfd image. Bound/rootpath come from the
        # fork-copied _spawn_* config. Never returns on success.
        _child_status_fd = _child_fd_high(sfd_w);
        var mfd = _child_fd_high(memfd);
        _child_shape_fds(rec, 0, 0);
        _child_exec_memfd(mfd, _spawn_bound, _spawn_rootpath);
        return _child_fail(SPAWN_ST_SETUP, EXECVE_FAILED);
    }
    # Supervisor: drop our memfd and fd copies (the grandchild has its own). 1.13.1: an image Linux
    # refused to run is the kernel's -1, not a pid that dies at once. Otherwise register the grandchild
    # with the CALLER as parent + needs_attach (the demux loop attaches it on its first stop).
    syscall(HOST_CLOSE, memfd);
    _inh_release();
    if (sfd_w >= 0) { syscall(HOST_CLOSE, sfd_w); }
    if (_sp_status(sfd_r) != 0) {
        var ws[8];
        _wait(cpid, &ws);                           # it exits right after the report: reap it here
        return _net_emu(pid, regs, 0 - 1);
    }
    var crec = _child_alloc(cpid, load64(rec + C_AGNOS_PID));
    store64(crec + C_NEEDS_ATTACH, 1);
    _child_cwd_inherit(crec, rec);                  # 1.13.1: born in its creator's directory
    # EMULATE: inject the coined agnos pid as spawn's return, skipping the foreign syscall.
    return _net_emu(pid, regs, load64(crec + C_AGNOS_PID));
}

# The agnos-visible exit code for an EXITED target record `t`: its retained exit_code — EXCEPT a
# child that died BEFORE it ever attached (execveat failed / killed pre-first-stop, so needs_attach
# is still set) surfaces as agnos -1, since its stashed code is a mirshi-internal EXECVE_FAILED/
# BOUND_FAILED, not a real agnos exit code. (WIFSIGNALED targets already carry exit_code -1.)
fn _wait_code(t): i64 {
    if (load64(t + C_NEEDS_ATTACH) == 1) { return 0 - 1; }
    return load64(t + C_EXIT_CODE);
}

# waitpid#4(pid) -> exit_code / -1. A SUPERVISOR-CONTROL op (may PARK the caller — leave it stopped —
# which needs loop cooperation, so handled at the loop level like spawn#3). If the target already
# EXITED, claim it (inject its code, free its slot). If still alive, PARK the caller (BLOCKED, left
# stopped at its enter-stop) until the target exits — the WIFEXITED handler (_wake_waiters) injects
# the code into this record's carry + releases it. Unknown / already-reaped target -> agnos -1. MVP:
# waits on ANY known pid (not scoped to direct children). `rec` is the CALLER's record.
fn _do_waitpid(pid, regs, rec): i64 {
    var target = decode_arg(regs, 0);
    var t = _child_find_by_agnos(target);
    if (t == 0) { return _net_emu(pid, regs, 0 - 1); }         # unknown / already reaped
    if (load64(t + C_STATE) == CS_EXITED) {
        # Zombie-claim fast path: inject the retained code, free the target slot.
        var code = _wait_code(t);
        _child_free(t);
        return _net_emu(pid, regs, code);
    }
    # Target still alive: PARK the caller. Skip the syscall (orig_rax=-1) so on resume it lands at
    # its exit stop; mark BLOCKED so the loop leaves it stopped. The code is injected into
    # C_XLAT_EMU_RET by _wake_waiters and written to rax at the caller's exit stop.
    store64(regs + REG_ORIG_RAX, 0 - 1);
    pt(PTRACE_SETREGS, pid, 0, regs);
    store64(rec + C_STATE, CS_BLOCKED);
    store64(rec + C_WAIT_TARGET, target);
    return STRAT_EMULATE;
}

# execwait#37 staging: the NUL-split command line + the NULL-terminated argv pointer vector into it.
# Lazy-alloc-once (ADR 0008 — never per-call, or a looping execwait grows the bump heap unbounded, like
# _spawn_elf_buffer). agnos caps the cmdline at 127 bytes (syscall.cyr #37: arg2 > 127 -> -1), so 129 =
# 127 + NUL + slack; 65*8 = 64 tokens + the NULL terminator. Both inherited across the spawn fork.
var _ew_cl = 0;
var _ew_argv = 0;
fn _ew_cl_buf(): i64 { if (_ew_cl == 0) { _ew_cl = alloc(1032); } return _ew_cl; }   # 1.12.3: room for a 1024 B argv blob
fn _ew_argv_buf(): i64 { if (_ew_argv == 0) { _ew_argv = alloc(17 * 8); } return _ew_argv; }   # 16 entries + NULL

# _spawn_from_path(pid, regs, rec, is43) -> new child record / -SPAWN_E_*. The shared core of the
# from-PATH exec band: read the cmdline "PATH arg1 arg2 .." (a1=ptr, a2=len | flags) from the child, stage
# it NUL-split on the supervisor heap (inherited across the fork) + build the NULL-terminated argv vector
# [path, args…] (agnos tokenizes on spaces, argv[0]=path), fork a traced grandchild that execve's the path
# token via _child_exec (the exact path the top-level program takes — a real FILE, no memfd; _child_setup
# re-establishes ROOTFD + the bound), and register it (CALLER = parent, needs_attach — the demux loop
# attaches on its first stop). 1.13.1: a relative program path resolves from the caller's cwd (at most
# 255 bytes once resolved); the child gets the env and cwd _sp_env decides, the caller's fd table, its
# armed redirects and (#43 only, `is43`) the CLEANFD scrub; an exec that fails is its -4 / -5. Consumed by
# execwait#37 (which then parks; it folds every failure to -1) + spawn_path#43 (which returns the pid).
# The callers clear the caller's redirect set on every return.
fn _spawn_from_path(pid, regs, rec, is43): i64 {
    # Returns the new child's record, or a negative SPAWN_E_* code (1.12.3: the kernel's a2 = len | flags
    # decoding — bit 16 ARGV blob, bit 17 CLEANFD — and its checks; mirshi used to take a2 as the length).
    if (_child_count() >= MAX_CHILDREN) { return 0 - SPAWN_E_NOPROC; }
    var cl_addr = decode_arg(regs, 0);
    var a2 = decode_arg(regs, 1);
    if (a2 < 0) { return 0 - SPAWN_E_ARGS; }
    var fl = a2 >> 16;
    if (fl > 3) { return 0 - SPAWN_E_ARGS; }
    var argv_form = fl & 1;
    var cl_len = a2 & 0xFFFF;
    if (argv_form == 0) {
        if (cl_len < 1) { return 0 - SPAWN_E_ARGS; }
        if (cl_len > 127) { return 0 - SPAWN_E_ARGS; }                     # SPAWN_LINE_MAX
    } else {
        if (cl_len < 2) { return 0 - SPAWN_E_ARGS; }
        if (cl_len > 1024) { return 0 - SPAWN_E_ARGS; }                    # SPAWN_ARGV_MAX
    }
    var cl = _ew_cl_buf();
    if (_spawn_read_elf(pid, cl_addr, cl_len, cl) < 0) { return 0 - SPAWN_E_ARGS; }
    store8(cl + cl_len, 0);
    var av = _ew_argv_buf();
    var nfwd = 0;
    var i = 0;
    if (argv_form == 1) {
        if (spawn_blob_ok(cl, cl_len) < 1) { return 0 - SPAWN_E_ARGS; }
        while (i < cl_len) {                                                # one entry per NUL
            store64(av + nfwd * 8, cl + i);
            nfwd = nfwd + 1;
            while (i < cl_len) { if (load8(cl + i) == 0) { break; } i = i + 1; }
            i = i + 1;
        }
    } else {
        if (spawn_line_tokens(cl, cl_len) > 16) { return 0 - SPAWN_E_ARGS; }   # SPAWN_ARGC_MAX: refused, never cut
        while (i < cl_len) {                                                # tokenize on spaces in place
            while (i < cl_len) { if (load8(cl + i) != 32) { break; } i = i + 1; }
            if (i >= cl_len) { break; }
            store64(av + nfwd * 8, cl + i);
            nfwd = nfwd + 1;
            while (i < cl_len) { if (load8(cl + i) == 32) { break; } i = i + 1; }
            if (i < cl_len) { store8(cl + i, 0); i = i + 1; }
        }
    }
    store64(av + nfwd * 8, 0);
    if (nfwd < 1) { return 0 - SPAWN_E_ARGS; }
    var path = load64(av + 0);                                                  # argv[0] = the ELF path token
    var ab = 0;                                                                 # the argv strings' size
    var q = 0;
    while (q < nfwd) { ab = ab + strlen(load64(av + q * 8)) + 1; q = q + 1; }
    # 1.13.1: the program path the kernel opens — a relative one joined to the caller's cwd, at most 255
    # bytes once resolved. argv[0] stays exactly what the caller wrote.
    _sp_bufs();
    var pl = strlen(path);
    memcpy(_sp_xpath, path, pl + 1);
    if (load8(_sp_xpath) != 47) {
        var xn = _path_resolve(_sp_xpath, pl);
        if (xn < 1) { return 0 - SPAWN_E_ARGS; }
        if (xn > SPAWN_PATH_MAX) { return 0 - SPAWN_E_ARGS; }
    }
    var envp = _sp_env(pid, regs, rec, fl, ab);                                 # + the child's cwd
    if (envp == 0) { return 0 - SPAWN_E_ARGS; }                                 # a flagged call's bad blob
    var clean = 0;
    if (is43 == 1) { clean = (fl >> 1) & 1; }                                   # SPAWN_F_CLEANFD (#43 only)
    _inh_collect(pid);
    var sp[8];
    var sfd_r = 0 - 1;
    var sfd_w = 0 - 1;
    if (_sp_pipe(&sp) == 0) { sfd_r = load32(&sp) & 0xFFFFFFFF; sfd_w = load32(&sp + 4) & 0xFFFFFFFF; }
    var cpid = sys_fork();
    if (cpid < 0) {
        _inh_release();
        if (sfd_r >= 0) { syscall(HOST_CLOSE, sfd_r); syscall(HOST_CLOSE, sfd_w); }
        return 0 - SPAWN_E_NOMEM;
    }
    if (cpid == 0) {
        # grandchild: its status fd above ROOTFD, the creator's table + its redirects (+ CLEANFD) at 0..31,
        # then the gauntlet and the exec. The fork-time copy of `rec` holds the redirect set.
        _child_status_fd = _child_fd_high(sfd_w);
        _child_shape_fds(rec, 1, clean);
        var inroot = 0;
        if (_spawn_rootpath != 0) { inroot = 1; }
        _child_exec(_sp_xpath, _spawn_bound, _spawn_rootpath, av, envp, INH_FDS, _child_status_fd, inroot);
        return _child_fail(SPAWN_ST_SETUP, EXECVE_FAILED);
    }
    # supervisor: drop our fd copies (the grandchild has its own), then learn whether the exec worked.
    _inh_release();
    if (sfd_w >= 0) { syscall(HOST_CLOSE, sfd_w); }
    var st = _sp_status(sfd_r);
    if (st != 0) {
        var ws[8];
        _wait(cpid, &ws);                                                       # it exits right after the report
        if (st == SPAWN_ST_SETUP) { return 0 - SPAWN_E_OTHER; }
        return 0 - spawn_exec_code(st);
    }
    var crec = _child_alloc(cpid, load64(rec + C_AGNOS_PID));
    store64(crec + C_NEEDS_ATTACH, 1);
    _child_set_name(crec, _sp_xpath);                # 1.13.0: the program's basename, for proclist#99
    if (_sp_cwd_n > 0) { _child_cwd_set(crec, _sp_cwd, _sp_cwd_n); }   # 1.13.1: seeded or inherited
    return crec;
}

# execwait#37(cmdline_addr, cmdline_len) -> child exit code / -1. agnos's ring-3 BLOCKING-exec: load a
# static ELF from a PATH and RUN IT TO COMPLETION, returning its exit code (agnsh's `run /bin/x`).
# = `_spawn_from_path` + **park** on the coined pid (the `_do_spawn` fork + `_do_waitpid` park fusion):
# `_wake_waiters` injects the child's exit code into rax at the caller's resume. Loop-level op (enr==37).
fn _do_execwait(pid, regs, rec): i64 {
    var crec = _spawn_from_path(pid, regs, rec, 0);
    _child_redir_clear(rec);                        # 1.13.1: every #37 return consumes the redirect set
    if (crec <= 0) { return _net_emu(pid, regs, 0 - 1); }   # #37 folds every failure to -1
    # PARK the caller on the coined pid until the child exits — exactly _do_waitpid's park.
    store64(regs + REG_ORIG_RAX, 0 - 1);
    pt(PTRACE_SETREGS, pid, 0, regs);
    store64(rec + C_STATE, CS_BLOCKED);
    store64(rec + C_WAIT_TARGET, load64(crec + C_AGNOS_PID));
    return STRAT_EMULATE;
}

# spawn_path#43(path, len) -> agnos pid / -1. agnos's NON-BLOCKING from-disk spawn — the cyrius stdlib
# exec_* path (`_agnos_spawn_path` + `sys_waitpid`, distinct from agnsh's execwait#37). = `_spawn_from_path`
# WITHOUT the park: inject the coined pid NOW; the caller reaps it via waitpid#4 later. Loop-level op
# (enr==43), the async sibling of execwait#37.
fn _do_spawn_path(pid, regs, rec): i64 {
    var crec = _spawn_from_path(pid, regs, rec, 1);
    _child_redir_clear(rec);                        # 1.13.1: every #43 return consumes the redirect set
    if (crec < 0) { return _net_emu(pid, regs, crec); }               # -SPAWN_E_*, as the kernel answers
    if (crec == 0) { return _net_emu(pid, regs, 0 - 1); }
    return _net_emu(pid, regs, load64(crec + C_AGNOS_PID));
}

# exec_redirect#62(src | op << 8, dst) -> 0 / -1. agnos's fd-redirect ARM for the caller's NEXT from-path
# child (execwait#37 / spawn_path#43; spawn#3 consumes none): that child's src fd becomes a copy of its dst
# fd (e.g. 1 <- a file or a pipe end). 1.13.1: the kernel's per-process set — op 0 replaces it with one
# pair, REDIR_ADD (0x100 | src) adds or re-points one (at most 4), REDIR_CLEAR (0x200) empties it; src and
# dst in [0, 32) (_child_redir_op). The pairs apply in arm order in the grandchild (_child_shape_fds), so
# `(1 <- w)` then `ADD(2 <- 1)` is `2>&1`; every #37 / #43 return clears the set. EMULATE. Loop-level.
fn _do_exec_redirect(pid, regs, rec): i64 {
    return _net_emu(pid, regs, _child_redir_op(rec, decode_arg(regs, 0), decode_arg(regs, 1)));
}

# When agnos pid `target` exits, release any waiters parked in waitpid#4 on it: for EACH BLOCKED
# record whose wait_target == target, stash the target's agnos-visible exit code into the waiter's
# carry, mark it RUNNING, and PTRACE_SYSCALL it — the waiter resumes to its waitpid exit stop where
# the loop injects the code into rax. Fan-out (many waiters on one pid all wake). Once claimed, the
# target's slot is freed (its host zombie was already reaped by the wait4(-1) that drove us here).
# 1.12.3: once `dead` has died, no one can wait for its children: free every EXITED record whose parent
# is `dead`, and `dead`'s own record when its parent is gone too (and no parked waiter claimed it).
# Without this, orphaned EXITED records held their slots for the rest of the run.
fn _reap_orphans(dead): i64 {
    var tbl = _child_tbl();
    var i = 0;
    while (i < MAX_CHILDREN) {
        var b = tbl + i * CHILD_REC_SIZE;
        if (load64(b + C_STATE) == CS_EXITED) {
            if (load64(b + C_PARENT) == dead) { _child_free(b); }
        }
        i = i + 1;
    }
    var d = _child_find_by_agnos(dead);
    if (d == 0) { return 0; }
    if (load64(d + C_STATE) != CS_EXITED) { return 0; }
    var par = _child_find_by_agnos(load64(d + C_PARENT));
    var gone = 0;
    if (par == 0) { gone = 1; } else { if (load64(par + C_STATE) == CS_EXITED) { gone = 1; } }
    if (gone == 1) { _child_free(d); }
    return 0;
}

fn _wake_waiters(target): i64 {
    var t = _child_find_by_agnos(target);
    if (t == 0) { return 0; }
    var code = _wait_code(t);
    var tbl = _child_tbl();
    var i = 0;
    var woke = 0;
    while (i < MAX_CHILDREN) {
        var w = tbl + i * CHILD_REC_SIZE;
        if (load64(w + C_STATE) == CS_BLOCKED) {
            if (load64(w + C_WAIT_TARGET) == target) {
                store64(w + C_XLAT_EMU_RET, code);          # the waitpid#4 return (injected at exit)
                store64(w + C_STATE, CS_RUNNING);
                pt(PTRACE_SYSCALL, load64(w + C_HOST_PID), 0, 0);   # release the parked waiter
                woke = 1;
            }
        }
        i = i + 1;
    }
    if (woke == 1) { _child_free(t); }   # all parked waiters claimed the target -> free its slot
    return 0;
}

# Break a wait deadlock — a self-wait (a child waitpids its own agnos pid) or a wait-cycle (A waits
# B, B waits A), or the last runnable child exiting with only parked waiters left. In all of these no
# CS_RUNNING tracee remains, so no target can ever exit to wake a parker, and wait4(-1) would block
# forever, WEDGING the single-threaded supervisor (worse than a hung program — the sandbox deputy
# itself hangs, holding host resources). The loop calls this when _any_running()==0: FAIL every
# parked waiter with agnos -1 and resume it to its waitpid exit stop. A program that then busy-retries
# waitpid just spins in userspace (bounded by rlimits / external kill), never wedging the supervisor.
# (0.6.0 hardening: a misbehaving/hostile child degrades gracefully, never wedges mirshi.)
fn _break_deadlock(): i64 {
    var tbl = _child_tbl();
    var i = 0;
    while (i < MAX_CHILDREN) {
        var w = tbl + i * CHILD_REC_SIZE;
        if (load64(w + C_STATE) == CS_BLOCKED) {
            store64(w + C_XLAT_EMU_RET, 0 - 1);                 # waitpid -> agnos -1 (target never wakes)
            store64(w + C_STATE, CS_RUNNING);
            pt(PTRACE_SYSCALL, load64(w + C_HOST_PID), 0, 0);   # resume to its waitpid exit stop
        }
        i = i + 1;
    }
    return 0;
}

# kill#16(pid, sig) -> 0 / -1. A SUPERVISOR-CONTROL op: validate sig (1..63) + pid!=0 + self/direct-
# child scope, then OR (1<<sig) into the TARGET's pending mask. The caller returns 0 on success — the
# target picks the bit up on its next pause#14 / signalfd#18 read (v1.6.0 is edge-triggered + non-
# blocking, so nothing to wake yet). `rec` is the CALLER's record.
fn _do_kill(pid, regs, rec): i64 {
    var tgt_pid = decode_arg(regs, 0);
    var sig = decode_arg(regs, 1);
    if (tgt_pid == 0) { return _net_emu(pid, regs, 0 - 1); }          # pid 0 protected (no broadcast)
    var probe = 0;
    if (sig == 0) { probe = 1; }                                     # 1.12.3: sig 0 only checks the target
    if (probe == 0) { if (_sig_valid(sig) != 1) { return _net_emu(pid, regs, 0 - 1); } }   # bad signal number
    var t = _child_find_by_agnos(tgt_pid);
    if (t == 0) { return _net_emu(pid, regs, 0 - 1); }               # unknown pid
    # Scope = self OR a DIRECT child of the caller (agnos "self/child only").
    var caller = load64(rec + C_AGNOS_PID);
    var ok = 0;
    if (t == rec) { ok = 1; }                                        # self
    if (load64(t + C_PARENT) == caller) { ok = 1; }                  # direct child
    if (ok == 0) { return _net_emu(pid, regs, 0 - 1); }             # not self/child -> denied
    if (probe == 1) { return _net_emu(pid, regs, 0); }               # authorized: 0, nothing posted
    store64(t + C_PENDING_SIG, load64(t + C_PENDING_SIG) | _sig_bit(sig));   # set the pending bit
    return _net_emu(pid, regs, 0);
}

# pause#14() -> 0. A BOUNDED YIELD — never blocks forever (that would wedge _agnos_sock_recv_block's
# TLS/HTTP poll loop, which yields via pause#14 between non-blocking sock_recv polls). If a deliverable
# signal is already pending, return 0 immediately; else idle a short quantum in the supervisor (the
# child is stopped at its trap — same nanosleep idiom as sleep_ms#41) then return 0. Matches agnos's
# "one hlt" edge-triggered contract; no CS_BLOCKED park, so no deadlock-guard interaction.
fn _do_pause(pid, regs, rec): i64 {
    if (_sig_deliverable(load64(rec + C_PENDING_SIG), load64(rec + C_SIG_BLOCKED)) != 0) {
        return _net_emu(pid, regs, 0);              # a deliverable signal is pending -> wake now
    }
    var req = _emu_ts_buf();
    store64(req, 0);                                # tv_sec = 0
    store64(req + 8, PAUSE_YIELD_NS);               # tv_nsec = the yield quantum
    syscall(SYS_NANOSLEEP, req, 0);
    return _net_emu(pid, regs, 0);
}

# Consume the post-execve SIGTRAP stop (delivered BEFORE options are set, so no
# 0x80 bit) and set ptrace options ONCE. Returns -1 when attached OK (proceed),
# else a >= 0 mirshi exit code to propagate immediately (the child died or
# misbehaved before tracing could begin — never ptrace a wrongly-assumed state).
fn _attach(pid, status): i64 {
    var w = _wait(pid, status);
    if (w < 0) {
        _emit(2, "mirshi: waitpid failed before trace began\n");
        return WAIT_FAILED;
    }
    var st = load64(status);
    if (WIFEXITED(st) == 1) {
        _emit(2, "mirshi: child exited before trace began (bad ELF?)\n");
        return WEXITSTATUS(st);
    }
    if (WIFSIGNALED(st) == 1) {
        _emit(2, "mirshi: child signalled before trace began\n");
        return 128 + WTERMSIG(st);
    }
    if (WIFSTOPPED(st) != 1) {
        _emit(2, "mirshi: child in unexpected state before trace began\n");
        return WAIT_FAILED;
    }
    # Tag syscall-stops (TRACESYSGOOD -> SIGTRAP|0x80) and SIGKILL the child if we
    # die (EXITKILL — no orphans).
    pt(PTRACE_SETOPTIONS, pid, 0, PTRACE_O_TRACESYSGOOD | PTRACE_O_EXITKILL);
    return 0 - 1;
}

# True (1) iff a non-syscall signal stop is a ptrace GROUP-STOP — the child hit a
# stopping signal (SIGSTOP/SIGTSTP/SIGTTIN/SIGTTOU) and the kernel stopped it —
# rather than an ordinary signal-delivery stop. Only those four signals can produce
# a group-stop, so PTRACE_GETSIGINFO is probed only for them: it FAILS with -EINVAL
# at a group-stop and SUCCEEDS at a signal-delivery stop (ptrace(2), "Group-stop").
# The trace loops use this to SUPPRESS a group-stop (resume with no signal, the
# ptrace-correct restart of a group-stopped tracee) instead of re-injecting the stop
# signal — re-injection delivers a stop the supervisor never originated. (Linux runs
# the child either way, so this is protocol correctness / cross-kernel robustness,
# not a fix for an observed wedge.) `si` is a caller-owned siginfo_t buffer
# (SIGINFO_SIZE). See docs/adr/0007.
fn _is_group_stop(pid, sig, si): i64 {
    var stopping = 0;
    if (sig == SIGSTOP) { stopping = 1; }
    if (sig == SIGTSTP) { stopping = 1; }
    if (sig == SIGTTIN) { stopping = 1; }
    if (sig == SIGTTOU) { stopping = 1; }
    if (stopping == 0) { return 0; }                            # not a stopping signal -> delivery stop
    # PTRACE_GETSIGINFO returns 0 at a signal-delivery stop and FAILS with exactly
    # -EINVAL at a group-stop. Test for -EINVAL precisely (not any < 0): a different
    # error — e.g. -ESRCH if the child raced to exit — is NOT a group-stop, so fall
    # through and let it be forwarded / reaped by the next wait.
    if (pt(PTRACE_GETSIGINFO, pid, 0, si) == 0 - 22) { return 1; }   # -EINVAL -> group-stop
    return 0;
}

# M0 trap-log mode (--selftest-trace). PTRACE_SYSEMU traps every syscall at entry
# — ONE stop per call, kernel executes NOTHING — logs the bare agnos event line,
# and tears the child down on agnos exit#0. Translates nothing. See docs/adr/0001.
fn _trace_log(pid): i64 {
    var regs = alloc(USER_REGS_SIZE);
    var status = alloc(8);
    var line = alloc(256);
    var siginfo = alloc(SIGINFO_SIZE);   # group-stop discrimination buffer (PTRACE_GETSIGINFO)

    var a = _attach(pid, status);
    if (a >= 0) { return a; }

    var pending_sig = 0;
    while (1 == 1) {
        pt(PTRACE_SYSEMU, pid, 0, pending_sig);    # advance to next entry; no exec
        pending_sig = 0;
        var w = _wait(pid, status);
        if (w < 0) { _emit(2, "mirshi: waitpid failed\n"); return WAIT_FAILED; }
        var st = load64(status);
        if (WIFEXITED(st) == 1) { return WEXITSTATUS(st); }
        if (WIFSIGNALED(st) == 1) { return 128 + WTERMSIG(st); }
        if (WIFSTOPPED(st) == 1) {
            var sig = WSTOPSIG(st);
            if (sig == SYSCALL_STOP_SIG) {
                pt(PTRACE_GETREGS, pid, 0, regs);
                var nr = decode_nr(regs);
                format_event(line, nr, decode_arg(regs, 0), decode_arg(regs, 1),
                  decode_arg(regs, 2), decode_arg(regs, 3));
                _emit(1, line);
                _emit(1, "\n");
                if (nr == 0) {
                    # agnos exit#0 — SYSEMU suppressed it; tear the child down.
                    var ecode = decode_arg(regs, 0);
                    syscall(SYS_KILL, pid, SIG_KILL);
                    _wait(pid, status);            # reap the corpse, no zombie
                    return ecode;
                }
            } else {
                # Non-syscall signal stop. For a group-stop (the child hit a stopping
                # signal) the ptrace-correct restart carries NO signal, so SUPPRESS it
                # (pending_sig stays 0 -> the top-of-loop resume passes data=0 and the
                # child continues) rather than re-injecting a stop the supervisor never
                # originated. A genuine signal-delivery stop is forwarded as before.
                # See _is_group_stop / docs/adr/0007.
                if (_is_group_stop(pid, sig, siginfo) == 1) { pending_sig = 0; }
                else { pending_sig = sig; }
            }
        }
    }
    return 0;
}

# M1 run mode (default). PTRACE_SYSCALL traps each syscall at ENTRY and EXIT (two
# stops/call, alternating). At ENTRY the dispatcher (src/dispatch.cyr) rewrites
# the call to its Linux peer (EXECUTE: kernel runs it in the child's own address
# space) or skips it with a supervisor-computed return (EMULATE/ENOSYS). At EXIT
# the raw return is mapped to the agnos convention. agnos exit#0 was rewritten to
# a real exit_group, so the child terminates and waitpid carries its status out.
# See docs/adr/0002.
fn _trace_run(root_pid): i64 {
    var regs = alloc(USER_REGS_SIZE);
    var status = alloc(8);
    var siginfo = alloc(SIGINFO_SIZE);   # group-stop discrimination buffer (PTRACE_GETSIGINFO)
    var raxbuf = alloc(8);               # 0.8.0: 1-word PTRACE_PEEKUSER target (exit reads only rax)

    var a = _attach(root_pid, status);
    if (a >= 0) { return a; }

    # v1.5.0 BITE 4: MULTI-TRACEE demux. spawn#3 (BITE 7) forks more traced children, so the loop
    # no longer waits on one pid — it _wait_any()s (wait4(-1, __WALL)) for the NEXT stop from ANY
    # child, looks the woken host pid up in the record table, services exactly ONE stop keyed on
    # THAT record, then resumes THAT child (resume-immediately — no cross-iteration pending_sig
    # carry). Each child's enter/exit carry + net table live in its record (BITEs 1-3), so
    # interleaved children never clobber one another. The loop returns only when the ROOT child
    # (agnos_pid 1) exits; a non-root exit stashes its code in the record and keeps looping (BITE 8
    # wakes any waitpid#4 parkers). PTRACE_O_EXITKILL (set in _attach) SIGKILLs a lingering grand-
    # child on teardown. With only the root present (no spawns yet) this is behaviorally identical
    # to the old single-child loop; the selftest path (_trace_log) stays single-child + untouched.
    # _attach left the root stopped at its initial stop — kick it into its first syscall-enter.
    pt(PTRACE_SYSCALL, root_pid, 0, 0);

    while (1 == 1) {
        # Deadlock guard: if no child is left running, no wait event will ever arrive and wait4(-1)
        # would wedge the supervisor (a self-wait / wait-cycle). Break parked waiters (-> agnos -1)
        # before blocking. Cheap (a MAX_CHILDREN scan) vs the ptrace-stop cost it precedes.
        if (_any_running() == 0) { _break_deadlock(); }
        var wpid = _wait_any(status);
        if (wpid < 0) { _emit(2, "mirshi: waitpid failed\n"); return WAIT_FAILED; }
        var rec = _child_find_by_host(wpid);
        if (rec == 0) {
            # A stop from a pid we have no record for (should not happen — spawn inserts the
            # record before the fork). Never deref null: resume it and move on.
            pt(PTRACE_SYSCALL, wpid, 0, 0);
        } else {
            var st = load64(status);
            if (WIFEXITED(st) == 1) {
                store64(rec + C_EXIT_CODE, WEXITSTATUS(st));   # incl. exit#0 -> exit_group
                store64(rec + C_STATE, CS_EXITED);
                if (load64(rec + C_AGNOS_PID) == 1) { return WEXITSTATUS(st); }   # ROOT -> supervisor exit
                _child_release(rec);                           # 1.12.3: close its sockets, free its slots
                _cm_on_death(load64(rec + C_AGNOS_PID));       # 1.12.1: a console_mode#110 holder's mode dies with it
                _wake_waiters(load64(rec + C_AGNOS_PID));      # release any waitpid#4 parkers on it
                _reap_orphans(load64(rec + C_AGNOS_PID));      # 1.12.3: records no one can wait for
            }
            if (WIFSIGNALED(st) == 1) {
                store64(rec + C_EXIT_CODE, 0 - 1);   # killed by signal -> agnos -1 (waitpid#4 sees -1)
                store64(rec + C_STATE, CS_EXITED);
                if (load64(rec + C_AGNOS_PID) == 1) { return 128 + WTERMSIG(st); }
                _child_release(rec);
                _cm_on_death(load64(rec + C_AGNOS_PID));
                _wake_waiters(load64(rec + C_AGNOS_PID));
                _reap_orphans(load64(rec + C_AGNOS_PID));
            }
            if (WIFSTOPPED(st) == 1) {
                if (load64(rec + C_NEEDS_ATTACH) == 1) {
                    # A spawn#3 grandchild's FIRST stop (post-execveat SIGTRAP, delivered before its
                    # options are set — no 0x80 bit). Attach it (tag syscall-stops + EXITKILL, as
                    # _attach does for the root), clear the flag, resume into its first syscall-enter;
                    # from its next stop on it is serviced like any other child.
                    pt(PTRACE_SETOPTIONS, wpid, 0, PTRACE_O_TRACESYSGOOD | PTRACE_O_EXITKILL);
                    store64(rec + C_NEEDS_ATTACH, 0);
                    pt(PTRACE_SYSCALL, wpid, 0, 0);
                    continue;
                }
                var sig = WSTOPSIG(st);
                if (sig == SYSCALL_STOP_SIG) {
                    if (load64(rec + C_AT_ENTRY) == 1) {
                        # Syscall-ENTER: read regs, classify, rewrite for the kernel.
                        _cur_rec = rec;   # BITE 3: the net-table accessor _net_tbl() reads this
                        # 1.12.3: a child killed between wait4 and here has no registers to read; skip the
                        # stop (the next wait4 reports its death) rather than dispatch stale ones.
                        if (pt(PTRACE_GETREGS, wpid, 0, regs) < 0) { continue; }
                        var enr = decode_nr(regs);
                        store64(rec + C_AGNOS_NR, enr);
                        # spawn#3 + waitpid#4 + execwait#37 are SUPERVISOR-CONTROL ops (fork a new tracee
                        # / park the caller), handled here at the loop level not in translate_dispatch —
                        # they need loop cooperation (a new tracee to attach; the caller left stopped).
                        # execwait#37 = spawn-from-path + park (run-to-completion). Everything else ->
                        # normal per-syscall translation.
                        var verdict = 0;
                        var handled = 0;
                        if (enr == 3) { verdict = _do_spawn(wpid, regs, rec); handled = 1; }
                        if (enr == 4) { verdict = _do_waitpid(wpid, regs, rec); handled = 1; }
                        if (enr == 37) { verdict = _do_execwait(wpid, regs, rec); handled = 1; }
                        if (enr == 43) { verdict = _do_spawn_path(wpid, regs, rec); handled = 1; }
                        if (enr == 62) { verdict = _do_exec_redirect(wpid, regs, rec); handled = 1; }
                        if (enr == 14) { verdict = _do_pause(wpid, regs, rec); handled = 1; }
                        if (enr == 16) { verdict = _do_kill(wpid, regs, rec); handled = 1; }
                        if (handled == 0) { verdict = translate_dispatch(wpid, regs); }
                        store64(rec + C_STRAT, verdict);
                        # Save this child's dispatch carry into its record; the globals are then
                        # free for the next child's stop (the isolation this whole arc buys).
                        store64(rec + C_XLAT_EMU_RET, _xlat_emu_ret);
                        store64(rec + C_M2_OUT_PTR, _m2_out_ptr);
                        store64(rec + C_M2_OUT_CAP, _m2_out_cap);
                        store64(rec + C_M2_SCRATCH, _m2_scratch);
                        store64(rec + C_AT_ENTRY, 0);
                    } else {
                        # Syscall-EXIT (0.8.0 hot-path opt; docs/benchmarks.md). The exit stop
                        # needs exactly ONE register: rax (the raw kernel return). So read just
                        # that word with PTRACE_PEEKUSER (8 bytes) instead of GETREGS (the full
                        # 216-byte register set), map it to the agnos convention, and write it
                        # back with PTRACE_POKEUSER (8 bytes) ONLY if it actually CHANGED. The
                        # syscall-dense SUCCESS path then costs one 8-byte peek and NO write-back
                        # at all — getpid/read/write/lseek/mmap/getrandom return values pass
                        # through unchanged, and stat success stays 0 with its output already
                        # repacked into child memory by fs_exit_return — vs the old GETREGS +
                        # unconditional SETREGS, two 216-byte cross-process copies. Byte-identical:
                        # at a syscall-exit the supervisor only ever wrote rax (rcx/r11 are kernel-
                        # restored, every other GP reg is child-preserved), so touching exactly
                        # rax, only when it differs, leaves the child resuming with precisely the
                        # rax the unconditional path would have set. Only ERROR returns (-errno ->
                        # -1, mmap/time -> 0), the getdents repack count, and the EMULATE/ENOSYS
                        # injection (raw rax is -ENOSYS there) differ -> POKEUSER fires.
                        # (PEEKUSER's raw ABI writes the word to the data pointer and returns
                        # 0/-errno; POKEUSER takes the value in data. REG_RAX=80 is the offset
                        # into struct user too — user_regs_struct is its leading member.)
                        # Restore this child's carry into the dispatch globals before the exit
                        # stop consumes them (agret reads _xlat_emu_ret; fs_exit_return reads _m2_*).
                        _xlat_emu_ret = load64(rec + C_XLAT_EMU_RET);
                        _m2_out_ptr = load64(rec + C_M2_OUT_PTR);
                        _m2_out_cap = load64(rec + C_M2_OUT_CAP);
                        _m2_scratch = load64(rec + C_M2_SCRATCH);
                        if (load64(rec + C_STRAT) != STRAT_EMULATE_DONE) {   # 1.12.3: rax already set at enter
                            pt(PTRACE_PEEKUSER, wpid, REG_RAX, raxbuf);
                            var raw = load64(raxbuf);
                            var agret = _xlat_emu_ret;           # EMULATE / ENOSYS: supervisor-computed
                            if (load64(rec + C_STRAT) == STRAT_EXECUTE) {
                                # fs_exit_return maps the return AND, for stat/getdents, repacks the
                                # Linux output struct into the child's saved buffer — a child-MEMORY
                                # write, independent of the rax write-back conditionally done below.
                                agret = fs_exit_return(wpid, load64(rec + C_AGNOS_NR), raw);
                            }
                            if (agret != raw) {
                                pt(PTRACE_POKEUSER, wpid, REG_RAX, agret);
                            }
                        }
                        store64(rec + C_AT_ENTRY, 1);
                    }
                    # Resume the serviced child — UNLESS waitpid#4 just PARKED it (BLOCKED; left
                    # stopped at its enter-stop until its target exits, when _wake_waiters releases it).
                    if (load64(rec + C_STATE) != CS_BLOCKED) {
                        pt(PTRACE_SYSCALL, wpid, 0, 0);
                    }
                } else {
                    # Non-syscall signal stop: SUPPRESS a group-stop (resume with no signal, the
                    # ptrace-correct restart), FORWARD a genuine signal-delivery stop. Resumed
                    # immediately — no cross-iteration pending_sig carry. See docs/adr/0007.
                    var psig = sig;
                    if (_is_group_stop(wpid, sig, siginfo) == 1) { psig = 0; }
                    pt(PTRACE_SYSCALL, wpid, 0, psig);
                }
            }
        }
    }
    return 0;
}

# Public entry: fork the agnos child, trace it to completion, return its code.
fn intercept_run(path, selftest, bound, rootpath, net_active, net_entries, net_count, net_listen_any, child_argv): i64 {
    # Confinement (and the child rootfd setup) applies only in RUN mode — selftest
    # (SYSEMU) executes nothing, so the child's paths never reach the kernel.
    var rp = rootpath;
    if (selftest == 1) { rp = 0; }
    if (rp != 0) {
        _confine_active = 1;
        # 1.12.3: the supervisor's own root anchor, for the confined path ops it now performs itself
        # (dispatch.cyr _cf_*). O_CLOEXEC: no child ever inherits it.
        _sup_rootfd = syscall(HOST_OPEN, rp, O_PATH | O_DIRECTORY | O_CLOEXEC, 0);
        if (_sup_rootfd < 0) {
            _emit(2, "mirshi: --root open failed — refusing to run unconfined\n");
            return BOUND_FAILED;
        }
    }
    # Net band (v1.1.0): the egress policy is enforced in the SUPERVISOR (run mode only —
    # selftest translates nothing). The parsed allow-list buffer lives in the supervisor
    # heap (alloc'd by main before fork); stash the pointer + count for the net handlers.
    var na = net_active;
    if (selftest == 1) { na = 0; }
    if (na == 1) {
        _net_active = 1;
        _net_entries = net_entries;
        _net_count = net_count;
        _net_listen_any = net_listen_any;
    }
    # The bounding allowlist is the RUN translation's output set; it does not fit the trace mode
    # (SYSEMU leaves the raw agnos numbers unrewritten), so only bound in run mode. Computed before
    # the fork so the child branch AND the spawn#3 config below share one value.
    var b = bound;
    if (selftest == 1) { b = 0; }
    # v1.5.0 spawn#3: stash the run-mode bound + rootpath so a supervisor-forked grandchild
    # (_child_exec_memfd) re-runs the same gauntlet (it inherits neither ROOTFD nor the filter).
    _spawn_bound = b;
    _spawn_rootpath = rp;
    # v1.5.0 multi-process: register the ROOT child (agnos_pid 1, the coined guest pid; parent 0) — 1.13.1:
    # BEFORE the fork, so its working directory and the init env built from it exist when it execs (the
    # host pid is filled in after the fork). The root starts in mirshi's own directory (at "/" under
    # --root) with the kernel loader's default env, HOME=/ and PWD=<that directory>.
    var rootrec = _child_alloc(0, 0);
    _child_set_name(rootrec, path);                  # 1.13.0: the target's basename, for proclist#99
    _cwd_root_init(rootrec);
    _sp_env_default(rootrec, 0 - 1);
    var pid = sys_fork();
    if (pid < 0) {
        _emit(2, "mirshi: fork failed\n");
        return 1;
    }
    if (pid == 0) {
        _child_exec(path, b, rp, child_argv, _sp_envp, 3, 0 - 1, 0);   # the operator's own target: a host path
        return EXECVE_FAILED;
    }
    store64(rootrec + C_HOST_PID, pid);
    if (selftest == 1) { return _trace_log(pid); }
    return _trace_run(pid);
}
