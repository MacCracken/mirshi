# band_fs.cyr — split out of src/dispatch.cyr in 1.12.3 (a pure move; included in order by src/intercept.cyr).

# One-path fs call (rmdir/unlink): stage the path into the child red zone, point
# rdi at it, renumber to `lnr`. The length arg in rsi is ignored by the 1-arg call.
fn _m2_one_path(pid, regs, lnr): i64 {
    var scratch = stage_at(pid, decode_arg(regs, 0), decode_arg(regs, 1),
      load64(regs + REG_RSP) - RED_ZONE);
    if (scratch < 0) { return _m2_fail(pid, regs); }
    store64(regs + REG_RDI, scratch);
    store64(regs + REG_ORIG_RAX, lnr);
    pt(PTRACE_SETREGS, pid, 0, regs);
    return STRAT_EXECUTE;
}

# Two-path fs call (rename/link): stage both explicit-length paths into two
# non-overlapping red-zone slots; Linux takes path1 in rdi, path2 in RSI — the
# agnos ABI passed path2 in rdx/r10, so this is a register MOVE, not a rewrite.
fn _m2_two_path(pid, regs, lnr): i64 {
    var s0 = stage_at(pid, decode_arg(regs, 0), decode_arg(regs, 1),
      load64(regs + REG_RSP) - RED_ZONE);
    if (s0 < 0) { return _m2_fail(pid, regs); }
    var s1 = stage_at(pid, decode_arg(regs, 2), decode_arg(regs, 3), s0);   # below s0
    if (s1 < 0) { return _m2_fail(pid, regs); }
    store64(regs + REG_RDI, s0);
    store64(regs + REG_RSI, s1);
    store64(regs + REG_ORIG_RAX, lnr);
    pt(PTRACE_SETREGS, pid, 0, regs);
    return STRAT_EXECUTE;
}

# --- 1.12.3: CONFINED path-mutation/metadata ops (--root), done IN THE SUPERVISOR. ---
#
# Until 1.12.3 these ran in the child as *at calls anchored at ROOTFD with a lexically sanitized path.
# The *at family has no RESOLVE_* flags, so a symlink already inside the rootfs whose target is an
# absolute host path was followed in an intermediate component, and mkdir / rmdir / unlink / rename /
# link / stat / readlink acted outside the root. Now the supervisor resolves the PARENT directory with
# openat2(_sup_rootfd, parent, O_PATH | O_DIRECTORY, RESOLVE_IN_ROOT | RESOLVE_NO_MAGICLINKS) — the
# same kernel-clamped resolution open#7 uses — and runs the *at call on the fd it gets back, so the
# resolution and the use are one object (no window for a sibling process to swap a component). The
# final component is acted on without following it (mkdirat / unlinkat / renameat2 / linkat /
# readlinkat never follow it); stat follows it, so it resolves the whole path with openat2 + fstat.
# EMULATE: the child runs nothing for these. See ADR 0009 (amended 1.12.3).
var _sup_rootfd = 0 - 1;        # the supervisor's own O_PATH root anchor (opened in intercept_run)
var _cf_path2 = 0;              # second path buffer for rename / link (PATH_MAX + 8)

# Read the agnos path (ptr, len) from the child into `buf` and make it root-relative (sanitize_rootrel).
# 0, or -1 for len < 1, len > PATH_MAX, an unreadable pointer, an interior NUL (the kernel looks up all
# `len` bytes, where Linux would stop at the NUL), or a `..` component.
fn _cf_read_path(pid, ptr, len, buf): i64 {
    if (len < 1) { return 0 - 1; }
    if (len > PATH_MAX) { return 0 - 1; }
    if (pvm_read(pid, ptr, buf, len) != len) { return 0 - 1; }
    if (path_has_nul(buf, len) == 1) { return 0 - 1; }
    store8(buf + len, 0);
    if (sanitize_rootrel(buf) < 0) { return 0 - 1; }
    return 0;
}

# Split the sanitized path in `buf` into its parent and its final component, in place. Returns the
# final component's address (the parent is then `buf`, or "." when there was no '/'), or 0 when there
# is no final component to act on: the root itself, or a path ending in "." (Linux EINVAL / EBUSY).
fn _cf_split(buf): i64 {
    var n = strlen(buf);
    while (n > 1) {                                   # drop trailing '/'
        if (load8(buf + n - 1) != 47) { n = 0 - n; } else { store8(buf + n - 1, 0); n = n - 1; }
    }
    if (n < 0) { n = 0 - n; }
    var i = n - 1;
    var slash = 0 - 1;
    while (i >= 0) {
        if (load8(buf + i) == 47) { slash = i; i = 0 - 1; } else { i = i - 1; }
    }
    var base = buf;
    if (slash >= 0) {
        store8(buf + slash, 0);                       # buf is now the parent
        base = buf + slash + 1;
    }
    if (load8(base) == 0) { return 0; }
    if (load8(base) == 46) {
        if (load8(base + 1) == 0) { return 0; }                                   # "."
        if (load8(base + 1) == 46) { if (load8(base + 2) == 0) { return 0; } }    # ".."
    }
    return base;
}

# An O_PATH | O_DIRECTORY fd for `rel` (root-relative), resolved inside the root by the kernel; or < 0.
fn _cf_open_in_root(rel, flags): i64 {
    var hb = _how_buf_get();
    store64(hb + 0, flags | O_PATH | O_CLOEXEC);
    store64(hb + 8, 0);
    store64(hb + 16, OPEN_RESOLVE);
    return syscall(SYS_OPENAT2, _sup_rootfd, rel, hb, OPEN_HOW_SIZE);
}

# The parent of the path just split into `buf`: "." when the split found no '/'.
fn _cf_parent_fd(buf, base): i64 {
    if (base == buf) { return _cf_open_in_root(".", O_DIRECTORY); }
    return _cf_open_in_root(buf, O_DIRECTORY);
}

# mkdir#9 / rmdir#10 / unlink#30: one path, one *at call on its resolved parent.
fn _cf_one(pid, regs, atnr, a3): i64 {
    _m2_init();
    if (_cf_read_path(pid, decode_arg(regs, 0), decode_arg(regs, 1), _m2_pathbuf) < 0) { return _net_emu(pid, regs, 0 - 1); }
    var base = _cf_split(_m2_pathbuf);
    if (base == 0) { return _net_emu(pid, regs, 0 - 1); }
    var pfd = _cf_parent_fd(_m2_pathbuf, base);
    if (pfd < 0) { return _net_emu(pid, regs, 0 - 1); }
    var r = syscall(atnr, pfd, base, a3);
    syscall(HOST_CLOSE, pfd);
    if (r < 0) { return _net_emu(pid, regs, 0 - 1); }
    return _net_emu(pid, regs, 0);
}

# rename#31 (renameat2, flags 0) / link#32 (linkat, flags 0: a symlink is linked, not followed).
fn _cf_two(pid, regs, atnr): i64 {
    _m2_init();
    if (_cf_path2 == 0) { _cf_path2 = alloc(PATH_MAX + 8); }
    if (_cf_read_path(pid, decode_arg(regs, 0), decode_arg(regs, 1), _m2_pathbuf) < 0) { return _net_emu(pid, regs, 0 - 1); }
    if (_cf_read_path(pid, decode_arg(regs, 2), decode_arg(regs, 3), _cf_path2) < 0) { return _net_emu(pid, regs, 0 - 1); }
    var b0 = _cf_split(_m2_pathbuf);
    var b1 = _cf_split(_cf_path2);
    if (b0 == 0) { return _net_emu(pid, regs, 0 - 1); }
    if (b1 == 0) { return _net_emu(pid, regs, 0 - 1); }
    var p0 = _cf_parent_fd(_m2_pathbuf, b0);
    if (p0 < 0) { return _net_emu(pid, regs, 0 - 1); }
    var p1 = _cf_parent_fd(_cf_path2, b1);
    if (p1 < 0) { syscall(HOST_CLOSE, p0); return _net_emu(pid, regs, 0 - 1); }
    var r = syscall(atnr, p0, b0, p1, b1, 0);
    syscall(HOST_CLOSE, p0);
    syscall(HOST_CLOSE, p1);
    if (r < 0) { return _net_emu(pid, regs, 0 - 1); }
    return _net_emu(pid, regs, 0);
}

# stat#33(path, pathlen, statbuf48): stat follows the final symlink, so the whole path is resolved in
# the root (openat2 O_PATH), fstat'd, repacked to the agnos 48 B struct and written to the caller.
fn _cf_stat(pid, regs): i64 {
    _m2_init();
    if (_cf_read_path(pid, decode_arg(regs, 0), decode_arg(regs, 1), _m2_pathbuf) < 0) { return _net_emu(pid, regs, 0 - 1); }
    var fd = _cf_open_in_root(_m2_pathbuf, 0);
    if (fd < 0) { return _net_emu(pid, regs, 0 - 1); }
    var r = syscall(SYS_FSTAT, fd, _m2_linbuf);
    syscall(HOST_CLOSE, fd);
    if (r != 0) { return _net_emu(pid, regs, 0 - 1); }
    stat_repack_144_to_48(_m2_linbuf, _m2_agnbuf);
    if (pvm_write(pid, decode_arg(regs, 2), _m2_agnbuf, 48) != 48) { return _net_emu(pid, regs, 0 - 1); }
    return _net_emu(pid, regs, 0);
}

# readlink#70(path, pathlen, buf, buflen): the link's text, truncated to buflen (the kernel's readlink
# since agnos 1.57.18, and Linux's), or -1. buflen < 1 is -1 (the kernel's cap < 1). The final component
# is never followed (readlinkat); at most PATH_MAX bytes are read.
fn _cf_readlink(pid, regs): i64 {
    _m2_init();
    var cap = decode_arg(regs, 3);
    if (cap < 1) { return _net_emu(pid, regs, 0 - 1); }
    if (cap > 4096) { cap = 4096; }
    if (_cf_read_path(pid, decode_arg(regs, 0), decode_arg(regs, 1), _m2_pathbuf) < 0) { return _net_emu(pid, regs, 0 - 1); }
    var base = _cf_split(_m2_pathbuf);
    if (base == 0) { return _net_emu(pid, regs, 0 - 1); }
    var pfd = _cf_parent_fd(_m2_pathbuf, base);
    if (pfd < 0) { return _net_emu(pid, regs, 0 - 1); }
    var n = syscall(SYS_READLINKAT, pfd, base, _m2_linbuf, cap);
    syscall(HOST_CLOSE, pfd);
    if (n < 0) { return _net_emu(pid, regs, 0 - 1); }
    if (pvm_write(pid, decode_arg(regs, 2), _m2_linbuf, n) != n) { return _net_emu(pid, regs, 0 - 1); }
    return _net_emu(pid, regs, n);
}

# EXIT-stop: stat#33 — the kernel wrote a Linux 144 B struct into the red-zone
# scratch; pull it out, repack to the agnos 48 B layout, write into the child's
# saved statbuf. Returns the agnos return (0 ok / -1 on stat error or short copy).
fn _m2_stat_exit(pid, lret): i64 {
    if (lret != 0) { return 0 - 1; }                 # Linux stat: 0 ok, -errno fail
    if (pvm_read(pid, _m2_scratch, _m2_linbuf, 144) != 144) { return 0 - 1; }
    stat_repack_144_to_48(_m2_linbuf, _m2_agnbuf);
    if (pvm_write(pid, _m2_out_ptr, _m2_agnbuf, 48) != 48) { return 0 - 1; }
    return 0;
}

# EXIT-stop: getdents#29 — the kernel wrote `lret` bytes of Linux getdents64
# records into the red-zone scratch; pull them out, repack into the agnos dirent
# layout (bounded by the child's bufsize), write into the child's saved buffer.
# Returns the agnos byte count (0 = end of dir / -1 on error or short copy).
fn _m2_getdents_exit(pid, lret): i64 {
    if (lret < 0) { return 0 - 1; }                  # -errno -> agnos -1
    if (lret == 0) { return 0; }                     # end of directory
    if (lret > 4096) { lret = 4096; }                # we capped the Linux read at 4096
    if (pvm_read(pid, _m2_scratch, _m2_linbuf, lret) != lret) { return 0 - 1; }
    var cap = _m2_out_cap;
    if (cap > 4096) { cap = 4096; }                  # bound to _m2_agnbuf
    var abytes = getdents_repack(_m2_linbuf, lret, _m2_agnbuf, cap);
    if (abytes < 0) { return 0 - 1; }                # the buffer cannot hold even one record
    if (pvm_write(pid, _m2_out_ptr, _m2_agnbuf, abytes) != abytes) { return 0 - 1; }
    return abytes;                                   # agnos return = repacked byte count
}

# EXIT-stop: pipe#25 — the kernel wrote the 2 x i32 host fds (read@0, write@4) into the red-zone
# scratch; widen each to u64 and write the agnos {u64 read_fd; u64 write_fd} (16 B) into the child's
# saved fds buffer. pipe2 returns 0 ok / -errno; a nonzero return or short copy -> agnos -1. Reuses
# the M2 repack scratch (single in-flight call, strict enter/exit alternation).
fn _m2_pipe_exit(pid, lret): i64 {
    if (lret != 0) { return 0 - 1; }                                 # pipe2 failed (-errno)
    if (pvm_read(pid, _m2_scratch, _m2_linbuf, 8) != 8) { return 0 - 1; }
    store64(_m2_agnbuf + 0, load32(_m2_linbuf + 0) & 0xFFFFFFFF);     # read fd  (i32 -> u64, zero-extend)
    store64(_m2_agnbuf + 8, load32(_m2_linbuf + 4) & 0xFFFFFFFF);     # write fd
    if (pvm_write(pid, _m2_out_ptr, _m2_agnbuf, 16) != 16) { return 0 - 1; }
    return 0;
}

# EXIT-stop return mapping for an executed fs call: stat/getdents/pipe need an output
# repack; everything else just maps the Linux return to the agnos convention.
fn fs_exit_return(pid, agnos_nr, lret): i64 {
    if (agnos_nr == 33) { return _m2_stat_exit(pid, lret); }
    if (agnos_nr == 29) { return _m2_getdents_exit(pid, lret); }
    if (agnos_nr == 25) { return _m2_pipe_exit(pid, lret); }
    return linux_ret_to_agnos(agnos_nr, lret);
}
