# src/children.cyr — the per-child process record table (v1.5.0 multi-process).
#
# mirshi supervises a small process tree: agnos spawn#3 forks a new traced child, and this
# table is the supervisor's per-child bookkeeping — one fixed record per live child, lazy-
# alloc-once (ADR 0008 discipline, like the net slot table). PURE: only alloc / load / store
# + module globals, no syscalls / ptrace — so it is unit-testable hermetically in
# tests/mirshi.tcyr (which includes only the pure modules).
#
# The pid mapping is a TWO-WAY {agnos_pid <-> host_pid} lookup. mirshi COINS the opaque
# guest-facing agnos pid (monotonic, root = 1, never reused) and maps it to the real host
# (Linux) pid used for wait4 / ptrace. The agnos pid CONTRACT is agnos-owned (an opaque token
# >= 0, 0 reserved, waitpid/kill self/child-scoped); the pid VALUE is mirshi-owned in
# direction 1 (no agnos kernel runs — mirshi is the process creator, same as it coins the net
# band's conn_id/listener_id). Coining opaque pids (never passing a host pid through) keeps
# this DIRECTION-AGNOSTIC: direction 2 (the v2+ Linux->AGNOS "swallow") flips the guest/host
# roles and reuses this same table + coiner.

enum MirshiChild {
    MAX_CHILDREN = 16;          # supervisor process cap — re-closes the ADR 0006 storm vector
    # that flipping spawn#3 to EMULATE reopens (deliberately NOT
    # RLIMIT_NPROC: per-uid + container-hostile, see limits.cyr).
    CHILD_REC_SIZE = 296;       # 23 x i64 fields + a 32-byte name + 10 cells (v1.7.0 grew it by 3: epoll /
    # timerfd / pipe tables; 1.12.1 by 1: the CM_NOSERIAL cell; 1.13.0 by the
    # name; 1.13.1 by the cwd length + the exec_redirect#62 set)
    # --- v1.6.0 signalfd#18 constants ---
    SIGFD_BASE = 0x20000000;    # emulated signalfd id = SIGFD_BASE + slot. Bit 29 — deliberately NOT
    # bit 30 (AGNOS_SOCK_TAG = 0x40000000): the agnos userland's sys_read/
    # write/close route bit-30-tagged fds to the net band BEFORE the
    # syscall, so a signalfd MUST clear bit 30 to reach mirshi's read#5.
    # Still way above any real child fd (rlimit caps them < 1024).
    SIGNALFD_SLOTS = 8;         # per-child signalfd table size (a process rarely needs > 1-2)
    SIGFD_SLOT_SIZE = 16;       # per slot {i64 watched_mask; i64 state} — SIGFD_FREE / SIGFD_OPEN
    SIGFD_FREE = 0 - 1;         # 1.12.2: the slot state is its own cell, never the caller's flags word
    SIGFD_OPEN = 0;
    # --- record field offsets (all i64) ---
    C_AGNOS_PID = 0;            # the opaque guest-facing pid mirshi coined (root = 1)
    C_HOST_PID = 8;            # the real Linux pid (the wait4 / ptrace target)
    C_PARENT = 16;             # parent's agnos_pid (bookkeeping; 0 = no parent / root)
    C_STATE = 24;             # CS_FREE / CS_RUNNING / CS_BLOCKED / CS_EXITED
    C_EXIT_CODE = 32;          # agnos exit code, retained until waitpid#4 claims it
    C_WAIT_TARGET = 40;        # the agnos_pid this child is parked in waitpid#4 on
    C_REAPED = 48;             # RESERVED (unused): waitpid#4 reaping frees the slot via _child_free
    # (-> CS_FREE) rather than a flag; C_STATE is authoritative, not this
    C_NEEDS_ATTACH = 56;       # 1 = a freshly-forked grandchild awaiting its first-stop attach
    C_AT_ENTRY = 64;           # enter/exit ptrace toggle (was a _trace_run local)
    C_AGNOS_NR = 72;           # agnos syscall nr captured at enter (was a _trace_run local)
    C_STRAT = 80;              # dispatcher verdict at enter (was a _trace_run local)
    C_PENDING_SIG = 88;        # v1.6.0: the per-child PENDING signal mask (agnos `1<<sig` — bit N =
    # signal N, NOT libc's 1<<(sig-1)). kill#16 sets bits; pause#14 /
    # signalfd#18 read them. Deliverable = pending & ~C_SIG_BLOCKED.
    C_XLAT_EMU_RET = 96;       # enter->exit EMULATE/ENOSYS return carry (was _xlat_emu_ret)
    C_M2_OUT_PTR = 104;        # fs exit-stop repack carry (was _m2_out_ptr)
    C_M2_OUT_CAP = 112;        #   "     (was _m2_out_cap)
    C_M2_SCRATCH = 120;        #   "     (was _m2_scratch)
    C_NET_TBL = 128;           # this child's net slot-table ptr (0 = not yet alloc'd)
    C_SIG_BLOCKED = 136;       # v1.6.0: the per-child BLOCKED signal mask (sigprocmask#17, `1<<sig`);
    # a signal is deliverable iff (C_PENDING_SIG & ~C_SIG_BLOCKED) has it
    C_SIGFD_TBL = 144;         # v1.6.0: this child's signalfd slot-table ptr (0 = not yet alloc'd)
    C_EPOLL_TBL = 152;         # v1.7.0: this child's epoll slot-table ptr (0 = not yet alloc'd)
    C_TIMERFD_TBL = 160;       # v1.7.0: this child's timerfd slot-table ptr (0 = not yet alloc'd)
    C_PIPE_TBL = 168;          # v1.7.0: RESERVED (unused in the MVP) — a watchable-pipe promotion would
    # store a supervisor-held {readfd,writefd} pair table here (ADR 0015)
    C_CON_NOSER = 176;         # 1.12.1: console_mode#110's PER-PROCESS CM_NOSERIAL cell (0 / 1). agnos
    # keeps it in the process's slot (proc_con_noser), so it dies with the
    # process and a spawned child starts without it. mirshi has no serial
    # mirror, so the bit changes no output — it is only reported back.
    C_NAME = 184;              # 1.13.0: the program's basename (<= 31 bytes + NUL, NUL-padded to 32), for proclist#99
    C_CWD_LEN = 216;           # 1.13.1: the working directory's length; 0 = "/" (the string is _child_cwd_ptr's)
    C_REDIR_N = 224;           # 1.13.1: exec_redirect#62 pairs armed for this process's next #37 / #43 child
    C_REDIR = 232;             # ...REDIR_MAX x {i64 src, i64 dst}, in arm order (64 B)
    REDIR_MAX = 4;             # the kernel's SPAWN_REDIR_MAX
    REDIR_OP_ADD = 1;          # #62 a1 = src | op << 8: op 1 adds a pair (or re-points an armed src)
    REDIR_OP_CLEAR = 2;        # op 2 (a1 exactly 0x200) empties the set
    # --- state values ---
    CS_FREE = 0;               # slot unused
    CS_RUNNING = 1;            # live, being traced
    CS_BLOCKED = 2;            # parked in waitpid#4 (left stopped at its enter-stop)
    CS_EXITED = 3;             # exited; exit_code retained until reaped
    # --- 1.13.0 proclist#99: the kernel's record `state` values (agnos-userland-abi §4.9) ---
    PL_STATE_READY = 1;        # a live process that is not the caller
    PL_STATE_RUNNING = 2;      # the caller itself (the one process on a CPU while it asks)
    PL_STATE_BLOCKED = 6;      # blocked in a kernel wait (mirshi: parked in waitpid#4 / execwait#37)
    PL_STATE_ZOMBIE = 7;       # exited, not yet reaped by its parent
    PL_REC_SIZE = 64;          # one proclist record
    SPAWN_ELF_MAX = 8388608;   # 8 MB spawn#3 ELF read cap — matches lib/process_agnos.cyr's
    # _AGNOS_ELF_MAX (the agnos-side spawn helper's own read buffer)
    # --- v1.7.0 I/O-multiplexing (epoll #19-21 / timerfd #22-23 / pipe #25) ---
    # epoll + timerfd are supervisor-EMULATED (a server epolls SOCKETS, which are supervisor-held host
    # fds in the per-child net table — a real in-child epoll fd cannot see them), so each returns an
    # opaque BASE+slot id the child later epoll_ctl's / read#5's / close#6's. Every base MUST clear bit
    # 30 (AGNOS_SOCK_TAG) so the agnos userland does not route it to the net band before it reaches
    # mirshi, AND stay distinct from SIGFD_BASE (bit 29). A strictly DESCENDING ladder lets
    # _emu_classify tier by a single >= compare; all sit far above real child fds (rlimit caps < 256).
    AGNOS_SOCK_TAG = 0x40000000; # bit 30 — the agnos userland's own socket-fd tag (routed to the net
    # band before any raw syscall mirshi sees). _emu_classify checks it
    # FIRST: 0x40000000 > SIGFD_BASE would otherwise mis-tier a socket id.
    TIMERFD_BASE = 0x10000000;   # bit 28: emulated timerfd id = TIMERFD_BASE + slot
    EPOLL_BASE = 0x08000000;     # bit 27: emulated epoll id = EPOLL_BASE + slot
    PIPE_BASE = 0x04000000;      # bit 26: RESERVED for a watchable-pipe promotion (unused in the MVP)
    MIN_EMU_BASE = 0x04000000;   # = PIPE_BASE — the low guard: fd >= this is a mirshi emulated id
    EPOLL_SLOTS = 4;             # per-child epoll instances (a server rarely needs > 1-2)
    EPOLL_SLOT_SIZE = 72;        # {i64 in_use (-1=FREE); 8 x i64 watched_id (-1=empty)} — the 8-watch list
    TIMERFD_SLOTS = 8;           # per-child timerfd instances
    TIMERFD_SLOT_SIZE = 32;      # {i64 flags (-1=FREE); i64 deadline_ms; i64 interval_ms; i64 armed}
    TIMERFD_SEC_CAP = 1000000000;# timerfd_settime seconds ceiling (~31.7 yr) — bounds untrusted child
    # input so sec*1000 + the deadline arithmetic stays well within i64
    # (a hostile initial/interval_sec would else overflow -> a wrong timer;
    # same discipline as sleep_ms#41's SLEEP_MS_CAP). Negatives are rejected.
    # _emu_classify KIND codes — the read#5 / close#6 emulated-fd front-gate tiers:
    KIND_REAL = 0;               # a real child fd (< MIN_EMU_BASE, bit 30 clear) — execute-in-child
    KIND_SOCK = 1;               # AGNOS_SOCK_TAG (bit 30) — a net-band conn / listen id
    KIND_SIGFD = 2;              # >= SIGFD_BASE — an emulated signalfd
    KIND_TIMERFD = 3;            # >= TIMERFD_BASE — an emulated timerfd
    KIND_EPOLL = 4;              # >= EPOLL_BASE — an emulated epoll instance
    KIND_PIPE = 5;               # >= PIPE_BASE — RESERVED (watchable pipe, unused in the MVP)
}

# True (1) iff `size` is a plausible spawn#3 ELF size: positive and within the SPAWN_ELF_MAX cap
# (the supervisor reads exactly this many bytes from the child before memfd + execveat). PURE —
# the bounds gate for _spawn_read_elf (intercept.cyr), unit-tested hermetically.
fn _spawn_size_ok(size): i64 {
    if (size <= 0) { return 0; }
    if (size > SPAWN_ELF_MAX) { return 0; }
    return 1;
}

# Record `path`'s basename as the process name (1.13.0, proclist#99): the bytes after the last '/', at most
# 31, NUL-padded to 32 — what the kernel's ELF loader records. Pure over the record.
fn _child_set_name(rec, path): i64 {
    var z = 0;
    while (z < 32) { store64(rec + C_NAME + z, 0); z = z + 8; }
    if (path == 0) { return 0; }
    var base = path;
    var p = path;
    while (load8(p) != 0) {
        if (load8(p) == 47) { base = p + 1; }
        p = p + 1;
    }
    var i = 0;
    while (i < 31) {
        var c = load8(base + i);
        if (c == 0) { return 0; }
        store8(rec + C_NAME + i, c);
        i = i + 1;
    }
    return 0;
}

# proclist#99's `state` for record `b` (1.13.0): 2 for the caller, 1 for another live process, 6 for one
# parked in waitpid#4 / execwait#37, 7 for an exited, unreaped one; 0 for a FREE slot (not listed). Pure.
fn _child_pl_state(b, caller): i64 {
    var st = load64(b + C_STATE);
    if (st == CS_FREE) { return 0; }
    if (b == caller) { return PL_STATE_RUNNING; }
    if (st == CS_BLOCKED) { return PL_STATE_BLOCKED; }
    if (st == CS_EXITED) { return PL_STATE_ZOMBIE; }
    return PL_STATE_READY;
}

# Fill the 64-byte proclist#99 record at `rec` from child record `b` (1.13.0): +0 pid, +8 state, +16 ppid,
# +24 the 32-byte NUL-padded name, +56 0 (the kernel's "neither cpu ticks nor rss present"). Pure.
fn _child_pl_fill(rec, b, caller): i64 {
    store64(rec + 0, load64(b + C_AGNOS_PID));
    store64(rec + 8, _child_pl_state(b, caller));
    store64(rec + 16, load64(b + C_PARENT));
    var k = 0;
    while (k < 32) { store64(rec + 24 + k, load64(b + C_NAME + k)); k = k + 8; }
    store64(rec + 56, 0);
    return 0;
}

# --- 1.13.1: the working directory (the kernel's proc_cwd_*: a normalized absolute path per process, a
#     STRING, not an inode). One CWD_SLOT string per record slot, in a table allocated once; length 0 is "/"
#     and never reads the table. ---
var _child_cwds = 0;
fn _child_cwd_ptr(rec): i64 {
    if (_child_cwds == 0) { _child_cwds = alloc(MAX_CHILDREN * CWD_SLOT); }
    return _child_cwds + ((rec - _child_tbl()) / CHILD_REC_SIZE) * CWD_SLOT;
}

# Set record `rec`'s cwd to the n bytes at `src` — a normalized absolute path (path_clean_join's output);
# "/" stores length 0. 0, or -1 for a length outside 1..CWD_MAX (nothing changed). Pure.
fn _child_cwd_set(rec, src, n): i64 {
    if (n < 1) { return 0 - 1; }
    if (n > CWD_MAX) { return 0 - 1; }
    if (n == 1) { store64(rec + C_CWD_LEN, 0); return 0; }
    var d = _child_cwd_ptr(rec);
    memcpy(d, src, n);
    store8(d + n, 0);
    store64(rec + C_CWD_LEN, n);
    return 0;
}

# A new process starts in its creator's directory (the kernel's proc_cwd_inherit). Pure.
fn _child_cwd_inherit(child, parent): i64 {
    var n = load64(parent + C_CWD_LEN);
    if (n > 0) { memcpy(_child_cwd_ptr(child), _child_cwd_ptr(parent), n + 1); }
    store64(child + C_CWD_LEN, n);
    return 0;
}

# --- 1.13.1: exec_redirect#62's per-process set (the kernel's redir_*: up to REDIR_MAX {src, dst} pairs, in
#     arm order, consumed — cleared — by every #37 / #43 return). ---
fn _child_redir_clear(rec): i64 { store64(rec + C_REDIR_N, 0); return 0; }
fn _child_redir_src(rec, i): i64 { return load64(rec + C_REDIR + i * 16); }
fn _child_redir_dst(rec, i): i64 { return load64(rec + C_REDIR + i * 16 + 8); }
fn _child_redir_is_src(rec, fd): i64 {
    var n = load64(rec + C_REDIR_N);
    var i = 0;
    while (i < n) { if (_child_redir_src(rec, i) == fd) { return 1; } i = i + 1; }
    return 0;
}

# exec_redirect#62(src | op << 8, dst) -> 0 / -1 over the caller's record (the kernel's arm):
#   op 0 (a1 in [0, 32)) replaces the set with this one pair;
#   op 1 (REDIR_ADD | src) adds a pair, or re-points an armed src; -1 when REDIR_MAX are armed;
#   op 2 (a1 exactly 0x200; dst ignored) empties the set;
#   anything else, src >= 32, or dst outside [0, 32) is -1 with the set unchanged. Pure.
fn _child_redir_op(rec, a1, a2): i64 {
    if (a1 < 0) { return 0 - 1; }
    var op = a1 >> 8;
    var src = a1 & 0xFF;
    if (op == REDIR_OP_CLEAR) {
        if (src != 0) { return 0 - 1; }
        return _child_redir_clear(rec);
    }
    if (op > REDIR_OP_ADD) { return 0 - 1; }
    if (src >= 32) { return 0 - 1; }
    if (a2 < 0) { return 0 - 1; }
    if (a2 >= 32) { return 0 - 1; }
    if (op == 0) {
        store64(rec + C_REDIR, src);
        store64(rec + C_REDIR + 8, a2);
        store64(rec + C_REDIR_N, 1);
        return 0;
    }
    var n = load64(rec + C_REDIR_N);
    var i = 0;
    while (i < n) {
        if (_child_redir_src(rec, i) == src) { store64(rec + C_REDIR + i * 16 + 8, a2); return 0; }
        i = i + 1;
    }
    if (n >= REDIR_MAX) { return 0 - 1; }
    store64(rec + C_REDIR + n * 16, src);
    store64(rec + C_REDIR + n * 16 + 8, a2);
    store64(rec + C_REDIR_N, n + 1);
    return 0;
}

# sched_yield_to#108's authority (1.13.0, the kernel's yt_auth_ok): 1 when the caller (record `caller`) may
# name agnos pid `t` — itself, a live (RUNNING / BLOCKED) direct child, or its live direct parent — else 0.
# pid 0 and the root's parent (0) have no record, so they are refused. Pure over the table.
fn _child_yield_ok(caller, t): i64 {
    var me = load64(caller + C_AGNOS_PID);
    if (t == me) { return 1; }
    var r = _child_find_by_agnos(t);
    if (r == 0) { return 0; }
    var st = load64(r + C_STATE);
    var live = 0;
    if (st == CS_RUNNING) { live = 1; }
    if (st == CS_BLOCKED) { live = 1; }
    if (live == 0) { return 0; }
    if (load64(r + C_PARENT) == me) { return 1; }
    if (load64(caller + C_PARENT) == t) { return 1; }
    return 0;
}

# Number of records in use (not FREE) — the live-process count spawn#3 checks BEFORE forking a new
# grandchild, so the supervisor never forks past the table (re-closes the ADR 0006 process-storm
# vector that flipping spawn to EMULATE reopens; not RLIMIT_NPROC, which is per-uid + container-
# hostile). Counts EXITED-but-unreaped records too (they still hold a slot until waitpid#4 reaps).
fn _child_count(): i64 {
    var tbl = _child_tbl();
    var i = 0;
    var c = 0;
    while (i < MAX_CHILDREN) {
        if (load64(tbl + i * CHILD_REC_SIZE + C_STATE) != CS_FREE) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

# Free a record slot after its exit code has been claimed (waitpid#4 reaped it), so the slot index
# is reusable. The agnos pid is NEVER reused (the monotonic coiner), so a later waitpid on the freed
# pid finds no record -> agnos -1 (correctly "already reaped / unknown pid").
fn _child_free(t): i64 {
    store64(t + C_STATE, CS_FREE);
    return 0;
}

# True (1) iff at least one record is CS_RUNNING — a tracee that can still generate a wait event.
# If NONE are running but some are BLOCKED (all parked in waitpid#4), no target can ever exit to
# wake them, so wait4(-1) would block forever and wedge the single-threaded supervisor — a self-wait
# or wait-cycle. The loop checks this before each wait4 to break such a deadlock (0.6.0 hardening: a
# misbehaving/hostile child must degrade gracefully, never wedge the sandbox deputy).
fn _any_running(): i64 {
    var tbl = _child_tbl();
    var i = 0;
    while (i < MAX_CHILDREN) {
        if (load64(tbl + i * CHILD_REC_SIZE + C_STATE) == CS_RUNNING) { return 1; }
        i = i + 1;
    }
    return 0;
}

# --- v1.6.0 signal-mask helpers (PURE, unit-tested). agnos masks are `1<<sig` (bit N = signal N),
#     NOT libc's 1<<(sig-1). Real signals are 1..63; kill#16 never sets bit 0. ---

# True (1) iff `sig` is a valid signal number (1..63) — guards the undefined `1<<sig` for sig<=0 /
# sig>=64 before kill#16 sets a bit.
fn _sig_valid(sig): i64 {
    if (sig < 1) { return 0; }
    if (sig > 63) { return 0; }
    return 1;
}

# The single-bit mask for `sig` (agnos `1<<sig`). Caller must `_sig_valid(sig)` first (no re-guard).
fn _sig_bit(sig): i64 {
    return 1 << sig;
}

# The deliverable set: signals pending AND not blocked. Cyrius has no unary `~`, so ~blocked is the
# two's-complement identity ~x == 0 - x - 1.
fn _sig_deliverable(pending, blocked): i64 {
    return pending & (0 - blocked - 1);
}

# The lowest set signal number in `mask` (1..63), or 0 if none — the delivery order (pause#14 /
# signalfd#18 hand out the lowest-numbered pending signal first).
fn _sig_lowest(mask): i64 {
    var i = 1;
    while (i <= 63) {
        if (((mask >> i) & 1) != 0) { return i; }
        i = i + 1;
    }
    return 0;
}

# `mask` with signal `sig`'s bit CLEARED (signalfd#18 delivery consumes the pending bit). Pure.
fn _sig_clear(mask, sig): i64 {
    return mask & (0 - (1 << sig) - 1);   # mask & ~(1<<sig)
}

# --- v1.7.0 pure I/O-mux helpers (hermetically unit-tested, beside _sig_deliverable) ---

# Classify an fd / watched-id by mirshi's emulated-fd tag ladder -> a KIND_* code. Checks AGNOS_SOCK_TAG
# (bit 30) FIRST — a socket id (0x40000000 + slot) exceeds SIGFD_BASE and would otherwise tier as a
# signalfd — then the strictly-descending base ladder. The read#5 / close#6 front gate routes an
# emulated id to its band with this; a real child fd (< MIN_EMU_BASE, bit 30 clear) -> KIND_REAL (rides
# the execute-in-child path). Pure.
fn _emu_classify(fd): i64 {
    if (fd < 0) { return KIND_REAL; }
    if ((fd & AGNOS_SOCK_TAG) != 0) { return KIND_SOCK; }
    if (fd >= SIGFD_BASE) { return KIND_SIGFD; }
    if (fd >= TIMERFD_BASE) { return KIND_TIMERFD; }
    if (fd >= EPOLL_BASE) { return KIND_EPOLL; }
    if (fd >= PIPE_BASE) { return KIND_PIPE; }
    return KIND_REAL;
}

# fd_kind#111 (1.12.1) for one of mirshi's EMULATED ids, by its _emu_classify KIND_* code: the three
# event fds the agnos kernel keeps as real fds (FDK_* from src/translate.cyr). A socket-tagged id
# (bit 30) is the cyrius stdlib's own userland handle, which the kernel answers -1 for, and the
# reserved pipe band has no ids. The caller checks the slot is OPEN first (a freed slot is a closed
# fd: -1). Pure.
fn fdk_from_emu_kind(kind): i64 {
    if (kind == KIND_SIGFD) { return FDK_SIGNALFD; }
    if (kind == KIND_TIMERFD) { return FDK_TIMERFD; }
    if (kind == KIND_EPOLL) { return FDK_EPOLL; }
    return 0 - 1;
}

# The number of timerfd expirations to report at `now` for a timer whose next deadline is `deadline`
# (all ms). `interval` 0 = one-shot -> 1; periodic -> 1 + floor((now - deadline) / interval), the ticks
# elapsed since the deadline (matching Linux timerfd's u64 expiration count). Precondition: the caller
# has already checked armed && now >= deadline. Pure.
fn _timer_ticks(now, deadline, interval): i64 {
    if (interval <= 0) { return 1; }
    return 1 + (now - deadline) / interval;
}

# The record table + the monotonic agnos-pid coiner. Lazy-alloc-once.
var _children = 0;
var _next_agnos_pid = 1;        # 0 reserved (getppid=0 stays distinct); root child = 1

fn _child_tbl(): i64 {
    if (_children == 0) {
        _children = alloc(MAX_CHILDREN * CHILD_REC_SIZE);
        var z = 0;
        while (z < MAX_CHILDREN * CHILD_REC_SIZE) { store64(_children + z, 0); z = z + 8; }   # 1.12.3: every field starts 0
        var i = 0;
        while (i < MAX_CHILDREN) {
            store64(_children + i * CHILD_REC_SIZE + C_STATE, CS_FREE);
            i = i + 1;
        }
    }
    return _children;
}

# Reset the table + coiner. TEST-ONLY (the supervisor lazy-allocs once per process; the old
# table is abandoned to the bump allocator, which never frees — fine for a hermetic test).
fn _child_reset(): i64 {
    _children = 0;
    _child_cwds = 0;
    _next_agnos_pid = 1;
    return 0;
}

# Find the live record for a host (Linux) pid, or 0 if none. Only RUNNING and BLOCKED records match
# (1.12.3): an EXITED record's host process is already reaped, and the host may reuse its pid.
fn _child_find_by_host(hpid): i64 {
    var tbl = _child_tbl();
    var i = 0;
    while (i < MAX_CHILDREN) {
        var b = tbl + i * CHILD_REC_SIZE;
        var st = load64(b + C_STATE);
        if (st == CS_RUNNING) { if (load64(b + C_HOST_PID) == hpid) { return b; } }
        if (st == CS_BLOCKED) { if (load64(b + C_HOST_PID) == hpid) { return b; } }
        i = i + 1;
    }
    return 0;
}

# Find the record for an agnos pid, or 0 if none.
fn _child_find_by_agnos(apid): i64 {
    var tbl = _child_tbl();
    var i = 0;
    while (i < MAX_CHILDREN) {
        var b = tbl + i * CHILD_REC_SIZE;
        if (load64(b + C_STATE) != CS_FREE) {
            if (load64(b + C_AGNOS_PID) == apid) { return b; }
        }
        i = i + 1;
    }
    return 0;
}

# Allocate a record for a freshly-created host pid: coin the next agnos pid, fill the mapping
# + parent + RUNNING state, and zero the carry / wait fields. Returns the record ptr, or 0 if
# the table is full (the process-storm bound — spawn#3 injects agnos -1 on full).
fn _child_alloc(hpid, parent_apid): i64 {
    var tbl = _child_tbl();
    var i = 0;
    while (i < MAX_CHILDREN) {
        var b = tbl + i * CHILD_REC_SIZE;
        if (load64(b + C_STATE) == CS_FREE) {
            store64(b + C_AGNOS_PID, _next_agnos_pid);
            _next_agnos_pid = _next_agnos_pid + 1;
            store64(b + C_HOST_PID, hpid);
            store64(b + C_PARENT, parent_apid);
            store64(b + C_STATE, CS_RUNNING);
            store64(b + C_EXIT_CODE, 0);
            store64(b + C_WAIT_TARGET, 0);
            store64(b + C_REAPED, 0);
            store64(b + C_NEEDS_ATTACH, 0);
            store64(b + C_AT_ENTRY, 1);        # a child's first ptrace stop is a syscall-ENTER
            store64(b + C_AGNOS_NR, 0);
            store64(b + C_STRAT, 0);
            store64(b + C_PENDING_SIG, 0);
            store64(b + C_XLAT_EMU_RET, 0);
            store64(b + C_M2_OUT_PTR, 0);
            store64(b + C_M2_OUT_CAP, 0);
            store64(b + C_M2_SCRATCH, 0);
            store64(b + C_SIG_BLOCKED, 0);
            # 1.12.3: the slot keeps its net / signalfd / epoll / timerfd tables. _child_release emptied
            # them when the previous holder died, so they are reused instead of allocated again.
            store64(b + C_CON_NOSER, 0);        # 1.12.1: a new process starts without CM_NOSERIAL
            var nz = 0;
            while (nz < 32) { store64(b + C_NAME + nz, 0); nz = nz + 8; }   # 1.13.0: no name until one is set
            store64(b + C_CWD_LEN, 0);          # 1.13.1: "/" until the creator's cwd is copied in
            store64(b + C_REDIR_N, 0);          # 1.13.1: no redirects armed
            return b;
        }
        i = i + 1;
    }
    return 0;
}
